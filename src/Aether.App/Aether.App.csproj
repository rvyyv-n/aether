<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Aether_App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- Unpackaged standalone WinUI 3 desktop application -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Program.cs is the entry point, so a launch can be handed to a running window before any window exists. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Looks\*.cube" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- libmpv and ANGLE for the target platform. Native binaries must NOT be marked Content (which indexes them into PRI), but None with copy-to-output -->
  <PropertyGroup>
    <_NativeArch Condition="'$(Platform)' == 'x64' or '$(RuntimeIdentifier)' == 'win-x64' or ('$(Platform)' == 'AnyCPU' and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())' == 'x64')">x64</_NativeArch>
    <_NativeArch Condition="'$(Platform)' == 'arm64' or '$(RuntimeIdentifier)' == 'win-arm64'">arm64</_NativeArch>
    <_NativeArch Condition="'$(Platform)' == 'x86' or '$(RuntimeIdentifier)' == 'win-x86'">x86</_NativeArch>
    <_NativeArch Condition="'$(_NativeArch)' == ''">x64</_NativeArch>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Native\$(_NativeArch)\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aether.Core.Interop\Aether.Core.Interop.csproj" />
    <ProjectReference Include="..\Aether.Core.Playback\Aether.Core.Playback.csproj" />
    <ProjectReference Include="..\Aether.PvP.Review\Aether.PvP.Review.csproj" />
    <ProjectReference Include="..\Aether.Server.LanHost\Aether.Server.LanHost.csproj" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming breaks WinUI 3 XAML reflection and type metadata in unpackaged apps -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <!-- Unpackaged WinUI 3 PRI unification: guarantee resources.pri is always present next to the executable -->
  <Target Name="EnsureUnpackagedResourcesPri" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri"
          DestinationFiles="$(TargetDir)resources.pri"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pri')" />
  </Target>

  <Target Name="IncludeUnpackagedResourcesPriInPublish" BeforeTargets="GeneratePublishDependencyFile" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)resources.pri" Condition="Exists('$(TargetDir)resources.pri')">
        <RelativePath>resources.pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)$(TargetName).pri" Condition="Exists('$(TargetDir)$(TargetName).pri') and !Exists('$(TargetDir)resources.pri')">
        <RelativePath>resources.pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="EnsureUnpackagedResourcesPriForPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)resources.pri"
          DestinationFiles="$(PublishDir)resources.pri"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != '' and Exists('$(TargetDir)resources.pri')" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri"
          DestinationFiles="$(PublishDir)resources.pri"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != '' and Exists('$(TargetDir)$(TargetName).pri') and !Exists('$(PublishDir)resources.pri')" />
  </Target>
</Project>
