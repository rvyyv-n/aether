<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Aether_App.Controls"
    xmlns:local="using:Aether_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    Background="Transparent"
    DragEnter="OnDragEnter"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop"
    KeyboardAcceleratorPlacementMode="Hidden"
    PointerExited="OnPagePointerExited"
    PointerMoved="OnPagePointerMoved"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="O"
            Invoked="OnOpenAccelerator"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="O"
            Invoked="OnOpenUrlAccelerator"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator Key="Left" Invoked="OnBackAccelerator" />
        <KeyboardAccelerator Key="Right" Invoked="OnForwardAccelerator" />
        <KeyboardAccelerator Key="I" Invoked="OnSetInAccelerator" />
        <KeyboardAccelerator Key="O" Invoked="OnSetOutAccelerator" />
        <KeyboardAccelerator Key="Space" Invoked="OnPlayPauseAccelerator" />
        <KeyboardAccelerator Key="F" Invoked="OnFullScreenAccelerator" />
        <KeyboardAccelerator Key="M" Invoked="OnMuteAccelerator" />
        <KeyboardAccelerator Key="L" Invoked="OnLoopAccelerator" />
        <KeyboardAccelerator Key="T" Invoked="OnAlwaysOnTopAccelerator" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <!--
            Video. The surface is sized to the video's own aspect ratio, so the letterbox bars are
            the window backdrop (windowed) or black (full screen, VideoHost background), never mpv's clear colour.
        -->
        <Grid
            x:Name="VideoHost"
            Background="Transparent"
            DoubleTapped="OnVideoDoubleTapped"
            SizeChanged="OnVideoHostSizeChanged">
            <controls:MpvVideoSurface
                x:Name="VideoSurface"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0" />
        </Grid>

        <!--  Dims the video while a file is dragged over it.  -->
        <Rectangle
            x:Name="DropScrim"
            Fill="#99000000"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!--
            Home: empty, starting, opening, drag-over and startup-failure states share one layout
            (screens 1 and 2): the hero centred above the status strip.
        -->
        <Grid x:Name="HomeView">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Hero: tile, 16, title, 4, subtitle, 24, details (failures), 24, actions.  -->
            <StackPanel Margin="16,32,16,16" VerticalAlignment="Center">
                <Border
                    Width="{StaticResource AetherSizeHeroTile}"
                    Height="{StaticResource AetherSizeHeroTile}"
                    HorizontalAlignment="Center"
                    Background="{StaticResource AetherSurfaceGlassBrush}"
                    BorderBrush="{StaticResource AetherStrokeSurfaceBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AetherTileCornerRadius}">
                    <Grid>
                    <!--  Film frame drawn on the handoff's 24 px grid, so the stroke scales with it.  -->
                    <Viewbox
                        x:Name="HeroGlyph"
                        Width="{StaticResource AetherSizeHeroGlyph}"
                        Height="{StaticResource AetherSizeHeroGlyph}">
                        <Path
                            Width="24"
                            Height="24"
                            Data="M5,5 H19 A2,2 0 0 1 21,7 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 V7 A2,2 0 0 1 5,5 Z M7,5 V19 M17,5 V19 M3,9.5 H7 M3,14.5 H7 M17,9.5 H21 M17,14.5 H21"
                            Stroke="{StaticResource AetherTextPrimaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.25" />
                    </Viewbox>
                    <!--  Getting a stream (2.6): WinUI draws the ring's own stroke.  -->
                    <ProgressRing
                        x:Name="StreamProgress"
                        Width="{StaticResource AetherSizeProgressRing}"
                        Height="{StaticResource AetherSizeProgressRing}"
                        IsActive="False"
                        Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!--  Status title: an amber dot on failures, top-aligned so it centres on the 28 px first line.  -->
                <StackPanel
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Ellipse
                        x:Name="TitleDot"
                        Margin="0,11,0,0"
                        Style="{StaticResource AetherStatusDotStyle}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="HomeTitle"
                        Style="{StaticResource AetherSubtitleTextStyle}"
                        Text="No video loaded" />
                </StackPanel>
                <TextBlock
                    x:Name="HomeSubtitle"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AetherSecondaryTextStyle}"
                    Text="Drop a file or press Ctrl+O"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <!--
                    Details tile, failures only: min(480, window - 32) wide, one left edge per column
                    (72 and *, gap 16), labels in TextSecondary and values in TextPrimary.
                -->
                <Border
                    x:Name="DetailsPanel"
                    MaxWidth="480"
                    Margin="0,24,0,0"
                    Style="{StaticResource AetherGlassPanelStyle}"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="SearchedKey"
                            Style="{StaticResource AetherSecondaryTextStyle}"
                            Text="Searched" />
                        <TextBlock
                            x:Name="SearchedValue"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource AetherBodyTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ErrorKey"
                            Grid.Row="1"
                            Style="{StaticResource AetherSecondaryTextStyle}"
                            Text="Error" />
                        <TextBlock
                            x:Name="ErrorValue"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource AetherBodyTextStyle}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!--  Pills: 32 tall, at least 144 wide, gap 8; Emphasis on the left, Outline on the right.  -->
                <StackPanel
                    x:Name="OpenActions"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="OpenFileButton"
                        MinWidth="144"
                        Click="OnOpenFileClick"
                        Style="{StaticResource AetherEmphasisPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE838;" />
                            <TextBlock x:Name="OpenFileLabel" Text="Open file" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="OpenUrlButton"
                        MinWidth="144"
                        Click="OnOpenUrlClick"
                        Style="{StaticResource AetherOutlinePillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE71B;" />
                            <TextBlock x:Name="OpenUrlLabel" Text="Open URL" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button
                    x:Name="StreamCancelButton"
                    MinWidth="144"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Click="OnStreamCancelClick"
                    Content="Cancel"
                    Style="{StaticResource AetherOutlinePillButtonStyle}"
                    Visibility="Collapsed" />

                <!--
                    Recents (2.10): only with history, at most 3 rows of 52 with a gap of 4, in a column
                    of at most 400; a 32 tall header with the Clear list link.
                -->
                <StackPanel
                    x:Name="RecentsPanel"
                    MaxWidth="{StaticResource AetherSizeRecentsColumn}"
                    Margin="0,24,0,0"
                    Spacing="4"
                    Visibility="Collapsed">
                    <Grid Height="{StaticResource AetherSizeControl}">
                        <TextBlock
                            x:Name="RecentsHeader"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource AetherCaptionTextStyle}"
                            Text="Recent" />
                        <Button
                            x:Name="ClearRecentsButton"
                            Padding="8,0"
                            HorizontalAlignment="Right"
                            BorderBrush="Transparent"
                            Click="OnClearRecentsClick"
                            Content="Clear list"
                            FontSize="{StaticResource AetherCaptionFontSize}"
                            Foreground="{StaticResource AetherTextSecondaryBrush}"
                            Style="{StaticResource AetherOutlinePillButtonStyle}" />
                    </Grid>
                    <StackPanel x:Name="RecentsList" Spacing="4" />
                </StackPanel>
                <StackPanel
                    x:Name="FailureActions"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Button
                        x:Name="RetryButton"
                        MinWidth="144"
                        Click="OnRetryClick"
                        Style="{StaticResource AetherEmphasisPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE72C;" />
                            <TextBlock x:Name="RetryLabel" Text="Retry" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CopyDetailsButton"
                        MinWidth="144"
                        Click="OnCopyDetailsClick"
                        Style="{StaticResource AetherOutlinePillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE8C8;" />
                            <TextBlock x:Name="CopyDetailsLabel" Text="Copy details" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!--
                Status footer: reports the engine only, borderless on the backdrop. Dot, label and muted
                detail; startup work runs a 2 px bar along the bottom edge.
            -->
            <Border
                Grid.Row="1"
                Height="40"
                Padding="16,12"
                Margin="{StaticResource AetherPageMargin}">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="StatusDot"
                            Margin="0,5,0,0"
                            Style="{StaticResource AetherStatusDotStyle}" />
                        <TextBlock
                            x:Name="StatusLabel"
                            Foreground="{StaticResource AetherTextPrimaryBrush}"
                            Style="{StaticResource AetherCaptionTextStyle}" />
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource AetherCaptionTextStyle}" />
                    </StackPanel>
                    <!--  The negative margin cancels the strip's padding so the bar sits on its bottom edge.  -->
                    <ProgressBar
                        x:Name="StartupProgress"
                        Height="2"
                        MinHeight="2"
                        Margin="-16,0,-16,-12"
                        VerticalAlignment="Bottom"
                        IsIndeterminate="True" />
                </Grid>
            </Border>
        </Grid>

        <!--  Drag-over: the drop-target fill and a 1 px border, inset 8 from the edges and below the title bar.  -->
        <Rectangle
            x:Name="DropOutline"
            Margin="8,40,8,8"
            Fill="{StaticResource AetherFillDropTargetBrush}"
            IsHitTestVisible="False"
            RadiusX="8"
            RadiusY="8"
            Stroke="{StaticResource AetherStrokeDropTargetBrush}"
            StrokeThickness="1"
            Visibility="Collapsed" />

        <!--
            Top scrim, over video only: black 50% under the 32 px title bar, fading to 0 by 72 px, so
            the title text holds contrast over bright frames. It fades with the chrome.
        -->
        <Rectangle
            x:Name="TopScrim"
            Height="72"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource AetherSurfaceTopScrimColor}" />
                    <GradientStop Offset="0.4444" Color="{StaticResource AetherSurfaceTopScrimColor}" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--
            Settings (6.1): fills the window under the title bar, straight on the backdrop. Created on first open.
        -->
        <Border
            x:Name="SettingsHost"
            Margin="0,32,0,0"
            Visibility="Collapsed" />

        <!--
            Title bar: Back (settings only), name and release label (the drag region), the gear, then 138 px
            left clear for the system caption buttons. The buttons sit outside the drag region so they take clicks.
        -->
        <Grid
            x:Name="TitleBar"
            Height="{StaticResource AetherSizeTitleBar}"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SettingsBackButton"
                Click="OnSettingsBackClick"
                Content="&#xE72B;"
                Style="{StaticResource AetherTitleBarButtonStyle}"
                Visibility="Collapsed" />
            <Grid
                x:Name="TitleBarDragArea"
                Grid.Column="1"
                Background="Transparent">
                <!--
                    Shared baseline at y 20: both texts trim to their baseline and sit on the panel's bottom edge.
                -->
                <StackPanel
                    Height="20"
                    Margin="16,0,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="TitleAppName"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AetherCaptionStrongTextStyle}"
                        Text="Aether"
                        TextLineBounds="TrimToBaseline" />
                    <TextBlock
                        x:Name="TitleBadgeText"
                        MaxWidth="320"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AetherCaptionTextStyle}"
                        Text="Alpha"
                        TextLineBounds="TrimToBaseline"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Click="OnSettingsClick"
                Content="&#xE713;"
                Style="{StaticResource AetherTitleBarButtonStyle}" />
            <Border Grid.Column="3" Width="{StaticResource AetherSizeCaptionButtons}" />
        </Grid>

        <!--
            Export chip and clip drawer (s5-03, 5.3): 8 above the 84 px pill (24 + 84 + 8 = 116), right-aligned
            to it by sharing its width and margins. Fades with the controls.
        -->
        <Grid
            x:Name="ClipLayer"
            MaxWidth="{StaticResource AetherSizeOsdWidth}"
            Margin="16,0,16,116"
            VerticalAlignment="Bottom"
            PointerCanceled="OnOsdPointerExited"
            PointerEntered="OnOsdPointerEntered"
            PointerExited="OnOsdPointerExited"
            Visibility="Collapsed">
            <controls:ClipDrawer x:Name="ClipDrawer" />
        </Grid>

        <!--
            Transport pill (screen 5): the seek row, then the buttons, 4 apart. min(520, window - 32) wide and
            84 tall: padding 8 (7 here, the 1 px stroke is the eighth), two 32 px rows. Radius 24 is the
            16 px button radius plus the padding, so the corners stay concentric. 24 above the bottom.
            Below a 520 px pill, frame step, loop and always on top move into More controls (5.7).
        -->
        <Border
            x:Name="Osd"
            MaxWidth="{StaticResource AetherSizeOsdWidth}"
            Margin="16,0,16,24"
            Padding="7"
            VerticalAlignment="Bottom"
            Background="{StaticResource AetherSurfaceOsdBrush}"
            BorderBrush="{StaticResource AetherStrokeSurfaceBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AetherTransportCornerRadius}"
            PointerEntered="OnOsdPointerEntered"
            PointerExited="OnOsdPointerExited"
            PointerCanceled="OnOsdPointerExited"
            PointerCaptureLost="OnOsdPointerExited"
            SizeChanged="OnOsdSizeChanged"
            Visibility="Collapsed">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Row 1: current time, bar, duration, 12 apart and 8 in from the padding. TextPrimary only on the pill.  -->
                <Grid Padding="8,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PositionText"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherTimecodeTextStyle}"
                        Text="00:00" />
                    <controls:PrecisionSeekBar x:Name="SeekBar" Grid.Column="1" />
                    <TextBlock
                        x:Name="DurationText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherTimecodeTextStyle}"
                        Text="00:00" />
                </Grid>

                <!--  Row 2: 1fr / auto / 1fr, so the centre group is truly centred; 4 apart inside each group.  -->
                <Grid Grid.Row="1" Height="{StaticResource AetherSizeControl}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="OpenButton"
                            Click="OnOpenFileClick"
                            Content="&#xE838;"
                            Style="{StaticResource AetherIconButtonStyle}"
                            ToolTipService.Placement="Top"
                            ToolTipService.ToolTip="Open file (Ctrl+O)" />
                        <Button
                            x:Name="SpeedButton"
                            Click="OnSpeedClick"
                            Content="1.0×"
                            Style="{StaticResource AetherSpeedPillButtonStyle}"
                            ToolTipService.Placement="Top">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout
                                    x:Name="SpeedMenu"
                                    Closed="OnSpeedMenuClosed"
                                    MenuFlyoutPresenterStyle="{StaticResource AetherMenuFlyoutPresenterStyle}"
                                    Opened="OnSpeedMenuOpened"
                                    Placement="TopEdgeAlignedLeft" />
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="BackButton"
                            Click="OnBackClick"
                            Content="&#xEB9E;"
                            Style="{StaticResource AetherIconButtonStyle}"
                            ToolTipService.Placement="Top" />
                        <Button
                            x:Name="BackFrameButton"
                            Click="OnBackFrameClick"
                            Content="&#xE892;"
                            Style="{StaticResource AetherIconButtonStyle}"
                            ToolTipService.Placement="Top" />
                        <Button
                            x:Name="PlayPauseButton"
                            Click="OnPlayPauseClick"
                            Content="&#xE768;"
                            Style="{StaticResource AetherPlayButtonStyle}"
                            ToolTipService.Placement="Top"
                            ToolTipService.ToolTip="Play (Space)" />
                        <Button
                            x:Name="ForwardFrameButton"
                            Click="OnForwardFrameClick"
                            Content="&#xE893;"
                            Style="{StaticResource AetherIconButtonStyle}"
                            ToolTipService.Placement="Top" />
                        <Button
                            x:Name="ForwardButton"
                            Click="OnForwardClick"
                            Content="&#xEB9D;"
                            Style="{StaticResource AetherIconButtonStyle}"
                            ToolTipService.Placement="Top" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="4">
                        <ToggleButton
                            x:Name="LoopButton"
                            Click="OnLoopClick"
                            Content="&#xE8EE;"
                            Style="{StaticResource AetherIconToggleButtonStyle}"
                            ToolTipService.Placement="Top" />
                        <ToggleButton
                            x:Name="AlwaysOnTopButton"
                            Click="OnAlwaysOnTopClick"
                            Content="&#xE718;"
                            Style="{StaticResource AetherIconToggleButtonStyle}"
                            ToolTipService.Placement="Top" />
                        <!--
                            Volume lives in a flyout (5.8): 72 px slider, thumb 12 white. Clicking mutes; the
                            flyout opens on hover, or pinned from right-click or Shift+F10 so the keyboard can
                            reach the slider.
                        -->
                        <Button
                            x:Name="VolumeButton"
                            Click="OnVolumeClick"
                            Content="&#xE767;"
                            ContextRequested="OnVolumeContextRequested"
                            PointerCanceled="OnVolumeButtonPointerExited"
                            PointerEntered="OnVolumeButtonPointerEntered"
                            PointerExited="OnVolumeButtonPointerExited"
                            Style="{StaticResource AetherIconButtonStyle}"
                            ToolTipService.Placement="Top">
                            <FlyoutBase.AttachedFlyout>
                                <Flyout
                                    x:Name="VolumeFlyout"
                                    AllowFocusOnInteraction="False"
                                    Closed="OnVolumeFlyoutClosed"
                                    Opened="OnVolumeFlyoutOpened"
                                    Placement="Top">
                                    <Flyout.FlyoutPresenterStyle>
                                        <!--  Solid dialog fallback over video: in-app Acrylic does not sample the swap chain (ADR-0013).  -->
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Background" Value="{StaticResource AetherSurfaceDialogFallbackBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AetherStrokeSurfaceBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="{StaticResource AetherOverlayCornerRadius}" />
                                            <Setter Property="Padding" Value="12,0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Grid
                                        x:Name="VolumeFlyoutContent"
                                        Background="Transparent"
                                        PointerCanceled="OnVolumeFlyoutPointerExited"
                                        PointerEntered="OnVolumeFlyoutPointerEntered"
                                        PointerExited="OnVolumeFlyoutPointerExited">
                                        <Slider
                                            x:Name="VolumeSlider"
                                            Width="{StaticResource AetherSizeVolumeSlider}"
                                            VerticalAlignment="Center"
                                            AllowFocusOnInteraction="False"
                                            IsThumbToolTipEnabled="False"
                                            Maximum="100"
                                            Minimum="0"
                                            ValueChanged="OnVolumeChanged"
                                            Value="100">
                                            <Slider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource AetherFillRangeColor}" />
                                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource AetherFillRangeColor}" />
                                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{StaticResource AetherFillRangeColor}" />
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
                                                <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
                                                <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
                                                <x:Double x:Key="SliderInnerThumbWidth">12</x:Double>
                                                <x:Double x:Key="SliderInnerThumbHeight">12</x:Double>
                                            </Slider.Resources>
                                        </Slider>
                                    </Grid>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                        <Button
                            x:Name="MoreButton"
                            Click="OnMoreClick"
                            Content="&#xE712;"
                            Style="{StaticResource AetherIconButtonStyle}"
                            ToolTipService.Placement="Top"
                            Visibility="Collapsed">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout
                                    x:Name="MoreMenu"
                                    MenuFlyoutPresenterStyle="{StaticResource AetherMenuFlyoutPresenterStyle}"
                                    Placement="TopEdgeAlignedRight">
                                    <MenuFlyoutItem
                                        x:Name="MoreBackFrameItem"
                                        Click="OnBackFrameClick"
                                        KeyboardAcceleratorTextOverride=","
                                        Style="{StaticResource AetherMenuItemStyle}" />
                                    <MenuFlyoutItem
                                        x:Name="MoreForwardFrameItem"
                                        Click="OnForwardFrameClick"
                                        KeyboardAcceleratorTextOverride="."
                                        Style="{StaticResource AetherMenuItemStyle}" />
                                    <ToggleMenuFlyoutItem
                                        x:Name="MoreLoopItem"
                                        Click="OnLoopClick"
                                        KeyboardAcceleratorTextOverride="L"
                                        Style="{StaticResource AetherToggleMenuItemStyle}" />
                                    <ToggleMenuFlyoutItem
                                        x:Name="MoreAlwaysOnTopItem"
                                        Click="OnAlwaysOnTopClick"
                                        KeyboardAcceleratorTextOverride="T"
                                        Style="{StaticResource AetherToggleMenuItemStyle}" />
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                        <Button
                            x:Name="FullScreenButton"
                            Click="OnFullScreenClick"
                            Content="&#xE740;"
                            Style="{StaticResource AetherIconButtonStyle}"
                            ToolTipService.Placement="Top"
                            ToolTipService.ToolTip="Full screen (F)" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--
            Open URL (2.5): scrim over the whole window, the strip dimmed with everything else. The
            dialog is min(440, window - 32) wide with padding 24, on the solid dialog fallback because
            it can sit over the swap chain (ADR-0013). Play (Emphasis) left, Cancel right, equal halves.
        -->
        <Grid
            x:Name="OpenUrlOverlay"
            Background="{StaticResource AetherSurfaceScrimBrush}"
            Visibility="Collapsed">
            <Border
                MaxWidth="{StaticResource AetherSizeDialogWidth}"
                Margin="16"
                Padding="24"
                VerticalAlignment="Center"
                Background="{StaticResource AetherSurfaceDialogFallbackBrush}"
                BorderBrush="{StaticResource AetherStrokeSurfaceBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AetherOverlayCornerRadius}">
                <StackPanel TabFocusNavigation="Cycle">
                    <TextBlock
                        x:Name="OpenUrlTitle"
                        Style="{StaticResource AetherSubtitleTextStyle}"
                        Text="Open URL" />
                    <TextBlock
                        x:Name="OpenUrlFieldLabel"
                        Margin="0,16,0,0"
                        Style="{StaticResource AetherBodyTextStyle}"
                        Text="Video or stream link" />
                    <TextBox
                        x:Name="OpenUrlBox"
                        Margin="0,8,0,0"
                        Background="{StaticResource AetherFillInputBrush}"
                        InputScope="Url"
                        IsSpellCheckEnabled="False"
                        KeyDown="OnOpenUrlBoxKeyDown"
                        TextChanged="OnOpenUrlTextChanged" />
                    <!--  The hint, or a dot and the reason (Caption; the dot sits on the caption line).  -->
                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Ellipse
                            x:Name="OpenUrlNoteDot"
                            Margin="0,5,0,0"
                            Style="{StaticResource AetherStatusDotStyle}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="OpenUrlNoteText"
                            Style="{StaticResource AetherCaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Margin="0,24,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="OpenUrlPlayButton"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenUrlPlayClick"
                            IsEnabled="False"
                            Style="{StaticResource AetherEmphasisPillButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="{StaticResource AetherSizeIcon}"
                                    Glyph="&#xE768;" />
                                <TextBlock x:Name="OpenUrlPlayLabel" Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OpenUrlCancelButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenUrlCancelClick"
                            Content="Cancel"
                            Style="{StaticResource AetherOutlinePillButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
