<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Aether_App.Controls"
    xmlns:local="using:Aether_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    Background="Transparent"
    DragEnter="OnDragEnter"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop"
    KeyboardAcceleratorPlacementMode="Hidden"
    PointerExited="OnPagePointerExited"
    PointerMoved="OnPagePointerMoved"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="O"
            Invoked="OnOpenAccelerator"
            Modifiers="Control" />
        <KeyboardAccelerator Key="Space" Invoked="OnPlayPauseAccelerator" />
        <KeyboardAccelerator Key="F" Invoked="OnFullScreenAccelerator" />
        <KeyboardAccelerator Key="F11" Invoked="OnFullScreenAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <!--
            Video. The surface is sized to the video's own aspect ratio, so the letterbox bars are
            Mica (windowed) or black (full screen, VideoHost background), never mpv's clear colour.
        -->
        <Grid
            x:Name="VideoHost"
            Background="Transparent"
            DoubleTapped="OnVideoDoubleTapped"
            SizeChanged="OnVideoHostSizeChanged">
            <controls:MpvVideoSurface
                x:Name="VideoSurface"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0" />
        </Grid>

        <!--  Dims the video while a file is dragged over it.  -->
        <Rectangle
            x:Name="DropScrim"
            Fill="#99000000"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!--
            Home: empty, starting, opening, drag-over and startup-failure states share one layout,
            like the device page of the references: title, subtitle, glyph, status line, panel.
        -->
        <Grid
            x:Name="HomeView"
            Margin="{StaticResource AetherPageMargin}"
            Padding="0,32,0,0">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Status title: an amber dot on failures, top-aligned so it centres on the 28 px first line.  -->
            <StackPanel
                Margin="0,28,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Ellipse
                    x:Name="TitleDot"
                    Margin="0,11,0,0"
                    Style="{StaticResource AetherStatusDotStyle}"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="HomeTitle"
                    Style="{StaticResource AetherTitleTextStyle}"
                    Text="No video loaded" />
            </StackPanel>
            <TextBlock
                x:Name="HomeSubtitle"
                Grid.Row="1"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource AetherSecondaryTextStyle}"
                Text="Drop a file or press Ctrl+O" />

            <!--  Film frame glyph, in place of the references' product shot.  -->
            <Grid
                x:Name="HomeGlyph"
                Grid.Row="2"
                Width="112"
                Height="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Grid.OpacityTransition>
                <Border
                    x:Name="GlyphFrame"
                    BorderBrush="#59FFFFFF"
                    BorderThickness="1.5"
                    CornerRadius="8" />
                <Line
                    x:Name="GlyphSprocketLeft"
                    Margin="10,8"
                    HorizontalAlignment="Left"
                    Stroke="#59FFFFFF"
                    StrokeDashArray="1,2.5"
                    StrokeThickness="1.5"
                    Y2="54" />
                <Line
                    x:Name="GlyphSprocketRight"
                    Margin="10,8"
                    HorizontalAlignment="Right"
                    Stroke="#59FFFFFF"
                    StrokeDashArray="1,2.5"
                    StrokeThickness="1.5"
                    Y2="54" />
                <FontIcon
                    x:Name="GlyphPlay"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Foreground="#8CFFFFFF"
                    Glyph="&#xF5B0;" />
            </Grid>

            <!--  Status line: dot, label, muted detail ("● Engine ready · ANGLE · D3D11"). Colour is in the dot only.  -->
            <StackPanel
                Grid.Row="3"
                Margin="0,0,0,14"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Ellipse x:Name="StatusDot" Style="{StaticResource AetherStatusDotStyle}" />
                <TextBlock x:Name="StatusLabel" Style="{StaticResource AetherBodyTextStyle}" />
                <TextBlock
                    x:Name="StatusDetail"
                    Style="{StaticResource AetherSecondaryTextStyle}" />
            </StackPanel>

            <!--  Startup progress, between the status line and the panel.  -->
            <ProgressBar
                x:Name="StartupProgress"
                Grid.Row="3"
                Width="120"
                MinHeight="2"
                Margin="0,0,0,2"
                VerticalAlignment="Bottom"
                Foreground="{StaticResource AetherTextPrimaryBrush}"
                IsIndeterminate="True" />

            <!--
                Details tile, failures only: one left edge per column (72 and *, gap 16), labels in
                TextSecondary and values in TextPrimary, both plain Segoe. Retry / Open folder below.
            -->
            <Border
                x:Name="DetailsPanel"
                Grid.Row="4"
                Style="{StaticResource AetherPanelStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="SearchedKey"
                            Style="{StaticResource AetherSecondaryTextStyle}"
                            Text="Searched" />
                        <TextBlock
                            x:Name="SearchedValue"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource AetherBodyTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ErrorKey"
                            Grid.Row="1"
                            Style="{StaticResource AetherSecondaryTextStyle}"
                            Text="Error" />
                        <TextBlock
                            x:Name="ErrorValue"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource AetherBodyTextStyle}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
                            x:Name="RetryButton"
                            Click="OnRetryClick"
                            Content="Retry"
                            Style="{StaticResource AetherSelectedPillButtonStyle}" />
                        <Button
                            x:Name="OpenFolderButton"
                            Click="OnOpenFolderClick"
                            Content="Open folder"
                            Style="{StaticResource AetherPillButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!--  Inset dashed outline while a file is dragged over the window.  -->
        <Rectangle
            x:Name="DropOutline"
            Margin="8,40,8,8"
            IsHitTestVisible="False"
            RadiusX="8"
            RadiusY="8"
            Stroke="#4DFFFFFF"
            StrokeDashArray="4,3"
            StrokeThickness="1"
            Visibility="Collapsed" />

        <!--  Title bar strip: the window's drag region. The gradient shows only over video.  -->
        <Grid
            x:Name="TitleBar"
            Height="{StaticResource AetherTitleBarHeight}"
            VerticalAlignment="Top">
            <Rectangle x:Name="TitleBarScrim" Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#B3000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Grid x:Name="TitleBarDragArea" Background="Transparent">
                <!--  Name and badge are both 12 px, so they share a baseline; the badge trims at 320 (file names).  -->
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="TitleAppName"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherCaptionStrongTextStyle}"
                        Text="Aether" />
                    <Border
                        MaxWidth="320"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherBadgeStyle}">
                        <TextBlock
                            x:Name="TitleBadgeText"
                            Style="{StaticResource AetherCaptionTextStyle}"
                            Text="Alpha" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Playback controls: a full-width strip in the style of the references' status panel.  -->
        <Border
            x:Name="Osd"
            Margin="{StaticResource AetherPageMargin}"
            Padding="8,6,12,6"
            VerticalAlignment="Bottom"
            Background="{StaticResource AetherOsdBrush}"
            BorderBrush="{StaticResource AetherStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AetherPanelCornerRadius}"
            PointerEntered="OnOsdPointerEntered"
            PointerExited="OnOsdPointerExited"
            PointerCanceled="OnOsdPointerExited"
            PointerCaptureLost="OnOsdPointerExited"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="PlayPauseButton"
                    Click="OnPlayPauseClick"
                    Content="&#xE768;"
                    Style="{StaticResource AetherPlayButtonStyle}"
                    ToolTipService.ToolTip="Play (Space)" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <!--  Three blocks with equal 6 px gaps, so the slash is centred. TextPrimary only on the pill.  -->
                    <TextBlock
                        x:Name="PositionText"
                        Style="{StaticResource AetherTimecodeTextStyle}"
                        Text="00:00" />
                    <TextBlock Style="{StaticResource AetherTimecodeTextStyle}" Text="/" />
                    <TextBlock
                        x:Name="DurationText"
                        Style="{StaticResource AetherTimecodeTextStyle}"
                        Text="00:00" />
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <FontIcon
                        x:Name="VolumeIcon"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Foreground="{StaticResource AetherTextSecondaryBrush}"
                        Glyph="&#xE767;" />
                    <Slider
                        x:Name="VolumeSlider"
                        Width="88"
                        VerticalAlignment="Center"
                        AllowFocusOnInteraction="False"
                        IsThumbToolTipEnabled="False"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="OnVolumeChanged"
                        Value="100">
                        <Slider.Resources>
                            <SolidColorBrush x:Key="SliderTrackFill" Color="#26FFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#33FFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33FFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D9FFFFFF" />
                            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#D9FFFFFF" />
                            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="#FF0B0C0E" />
                        </Slider.Resources>
                    </Slider>
                </StackPanel>

                <Button
                    x:Name="FullScreenButton"
                    Grid.Column="4"
                    Click="OnFullScreenClick"
                    Content="&#xE740;"
                    Style="{StaticResource AetherIconButtonStyle}"
                    ToolTipService.ToolTip="Full screen (F)" />
            </Grid>
        </Border>
    </Grid>
</Page>
