<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Aether_App.Controls"
    xmlns:local="using:Aether_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    Background="Transparent"
    ContextRequested="OnPageContextRequested"
    DragEnter="OnDragEnter"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop"
    KeyboardAcceleratorPlacementMode="Hidden"
    PointerExited="OnPagePointerExited"
    PointerMoved="OnPagePointerMoved"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            Tracks flyout (9.2): opened from Audio and Subtitles in the right-click menu, centred above the pill. A translucent
            surface: the render thread blurs the video behind it (ADR-0013); the panel scrolls inside it (MainPage.Tracks.cs).
        -->
        <Flyout
            x:Name="TracksFlyout"
            Closed="OnTracksFlyoutClosed"
            Opened="OnTracksFlyoutOpened"
            Placement="Top">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="RequestedTheme" Value="Dark" />
                    <Setter Property="Background" Value="{ThemeResource AetherSurfaceDialogBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource AetherStrokeSurfaceBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{StaticResource AetherOverlayCornerRadius}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MaxWidth" Value="600" />
                    <Setter Property="MaxHeight" Value="2000" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <controls:TracksPanel x:Name="TracksPanel" RequestedTheme="Dark" />
        </Flyout>

        <!--  Video flyout (9.3): right-aligned to the pill, on the same surface as the tracks flyout (MainPage.Video.cs).  -->
        <Flyout
            x:Name="VideoFlyout"
            Closed="OnVideoFlyoutClosed"
            Opened="OnVideoFlyoutOpened"
            Placement="TopEdgeAlignedRight">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter">
                    <Setter Property="RequestedTheme" Value="Dark" />
                    <Setter Property="Background" Value="{ThemeResource AetherSurfaceDialogBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource AetherStrokeSurfaceBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{StaticResource AetherOverlayCornerRadius}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MaxWidth" Value="600" />
                    <Setter Property="MaxHeight" Value="2000" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <controls:VideoPanel x:Name="VideoPanel" RequestedTheme="Dark" />
        </Flyout>
    </Page.Resources>

    <!--  Escape is fixed. Every other shortcut is added from the shortcut settings (MainPage.Shortcuts.cs).  -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
    </Page.KeyboardAccelerators>

    <Grid>
        <!--
            Video. The surface is sized to the video's own aspect ratio, so the letterbox bars are
            the window backdrop (windowed) or black (full screen, VideoHost background), never mpv's clear colour.
        -->
        <Grid
            x:Name="VideoHost"
            Background="Transparent"
            DoubleTapped="OnVideoDoubleTapped"
            SizeChanged="OnVideoHostSizeChanged">
            <FlyoutBase.AttachedFlyout>
                <!--
                    Right-click menu (9.1): solid like the transport menus and as wide as its longest label and shortcut
                    (the menu row styles in DesignTokens.xaml); the Recent submenu is 288. Labels, shortcuts and which
                    entries are enabled come from the code (MainPage.ContextMenu.cs).
                -->
                <MenuFlyout
                    x:Name="ContextMenu"
                    Closed="OnContextMenuClosed"
                    MenuFlyoutPresenterStyle="{StaticResource AetherMenuFlyoutPresenterStyle}"
                    Opened="OnContextMenuOpened"
                    Placement="BottomEdgeAlignedLeft">
                    <MenuFlyoutItem
                        x:Name="CtxOpenFile"
                        Click="OnOpenFileClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE838;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="CtxOpenUrl"
                        Click="OnOpenUrlClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE71B;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem
                        x:Name="CtxRecent"
                        Style="{StaticResource AetherMenuSubItemStyle}">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE81C;" />
                        </MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="CtxAudio"
                        Click="OnTracksMenuClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE767;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="CtxSubtitles"
                        Click="OnTracksMenuClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE7F0;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSubItem
                        x:Name="CtxSpeed"
                        Style="{StaticResource AetherMenuSubItemStyle}">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xEC4A;" />
                        </MenuFlyoutSubItem.Icon>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem
                        x:Name="CtxVideo"
                        Click="OnVideoMenuClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE714;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="CtxCopyFrame"
                        Click="OnCopyFrameMenuClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE8C8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="CtxSaveFrame"
                        Click="OnSaveFrameMenuClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE74E;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="CtxPictureInPicture"
                        Click="OnPictureInPictureMenuClick"
                        KeyboardAcceleratorTextOverride="P"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xEE49;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <ToggleMenuFlyoutItem
                        x:Name="CtxAlwaysOnTop"
                        Click="OnAlwaysOnTopClick"
                        Style="{StaticResource AetherToggleMenuItemStyle}">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE840;" />
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="CtxDiagnostics"
                        Click="OnDiagnosticsMenuClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE9D9;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="CtxSettings"
                        Click="OnSettingsMenuClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="CtxClips"
                        Click="OnClipsMenuClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE8F1;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        x:Name="CtxStream"
                        Click="OnStreamMenuClick"
                        Style="{StaticResource AetherMenuItemStyle}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE774;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </FlyoutBase.AttachedFlyout>
            <controls:MpvVideoSurface
                x:Name="VideoSurface"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0" />
        </Grid>

        <!--  Dims the video while a file is dragged over it.  -->
        <Rectangle
            x:Name="DropScrim"
            Fill="#99000000"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <!--
            Home: empty, starting, opening, drag-over and startup-failure states share one layout
            (screens 1 and 2): the hero centred above the status strip.
        -->
        <Grid x:Name="HomeView">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Hero: tile, 16, title, 4, subtitle, 24, details (failures), 24, actions.  -->
            <StackPanel x:Name="HomeHero" Margin="16,32,16,16" VerticalAlignment="Center">
                <Border
                    Width="{StaticResource AetherSizeHeroTile}"
                    Height="{StaticResource AetherSizeHeroTile}"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource AetherSurfaceGlassBrush}"
                    BorderBrush="{ThemeResource AetherStrokeSurfaceBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AetherTileCornerRadius}">
                    <Grid>
                    <!--  Film frame drawn on the handoff's 24 px grid, so the stroke scales with it.  -->
                    <Viewbox
                        x:Name="HeroGlyph"
                        Width="{StaticResource AetherSizeHeroGlyph}"
                        Height="{StaticResource AetherSizeHeroGlyph}">
                        <Path
                            Width="24"
                            Height="24"
                            Data="M5,5 H19 A2,2 0 0 1 21,7 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 V7 A2,2 0 0 1 5,5 Z M7,5 V19 M17,5 V19 M3,9.5 H7 M3,14.5 H7 M17,9.5 H21 M17,14.5 H21"
                            Stroke="{ThemeResource AetherTextPrimaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.25" />
                    </Viewbox>
                    <!--  Getting a stream (2.6): WinUI draws the ring's own stroke.  -->
                    <ProgressRing
                        x:Name="StreamProgress"
                        Width="{StaticResource AetherSizeProgressRing}"
                        Height="{StaticResource AetherSizeProgressRing}"
                        IsActive="False"
                        Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!--  Status title: an amber dot on failures, top-aligned so it centres on the 28 px first line.  -->
                <StackPanel
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <Ellipse
                        x:Name="TitleDot"
                        Margin="0,11,0,0"
                        Style="{StaticResource AetherStatusDotStyle}"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="HomeTitle"
                        Style="{StaticResource AetherSubtitleTextStyle}"
                        Text="No video loaded" />
                </StackPanel>
                <TextBlock
                    x:Name="HomeSubtitle"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AetherSecondaryTextStyle}"
                    Text="Drop a file or press Ctrl+O"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <!--
                    Details tile, failures only: min(480, window - 32) wide, one left edge per column
                    (72 and *, gap 16), labels in TextSecondary and values in TextPrimary.
                -->
                <Border
                    x:Name="DetailsPanel"
                    MaxWidth="480"
                    Margin="0,24,0,0"
                    Style="{StaticResource AetherGlassPanelStyle}"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="SearchedKey"
                            Style="{StaticResource AetherSecondaryTextStyle}"
                            Text="Searched" />
                        <TextBlock
                            x:Name="SearchedValue"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource AetherBodyTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ErrorKey"
                            Grid.Row="1"
                            Style="{StaticResource AetherSecondaryTextStyle}"
                            Text="Error" />
                        <TextBlock
                            x:Name="ErrorValue"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource AetherBodyTextStyle}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!--  Pills: 32 tall, at least 144 wide, gap 8; Emphasis on the left, Outline on the right.  -->
                <StackPanel
                    x:Name="OpenActions"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="OpenFileButton"
                        MinWidth="144"
                        Click="OnOpenFileClick"
                        Style="{StaticResource AetherEmphasisPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE838;" />
                            <TextBlock x:Name="OpenFileLabel" Text="Open file" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="OpenUrlButton"
                        MinWidth="144"
                        Click="OnOpenUrlClick"
                        Style="{StaticResource AetherOutlinePillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE71B;" />
                            <TextBlock x:Name="OpenUrlLabel" Text="Open URL" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button
                    x:Name="StreamCancelButton"
                    MinWidth="144"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Click="OnStreamCancelClick"
                    Content="Cancel"
                    Style="{StaticResource AetherOutlinePillButtonStyle}"
                    Visibility="Collapsed" />

                <!--
                    Recents (2.10): only with history, at most 3 rows of 52 with a gap of 4, in a column
                    of at most 400; a 32 tall header with the Clear list link.
                -->
                <StackPanel
                    x:Name="RecentsPanel"
                    MaxWidth="{StaticResource AetherSizeRecentsColumn}"
                    Margin="0,24,0,0"
                    Spacing="4"
                    Visibility="Collapsed">
                    <Grid Height="{StaticResource AetherSizeControl}">
                        <TextBlock
                            x:Name="RecentsHeader"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource AetherCaptionTextStyle}"
                            Text="Recent" />
                        <Button
                            x:Name="ClearRecentsButton"
                            Padding="8,0"
                            HorizontalAlignment="Right"
                            BorderBrush="Transparent"
                            Click="OnClearRecentsClick"
                            Content="Clear list"
                            FontSize="{StaticResource AetherCaptionFontSize}"
                            Foreground="{ThemeResource AetherTextSecondaryBrush}"
                            Style="{StaticResource AetherOutlinePillButtonStyle}" />
                    </Grid>
                    <StackPanel x:Name="RecentsList" Spacing="4" />
                </StackPanel>
                <StackPanel
                    x:Name="FailureActions"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Button
                        x:Name="RetryButton"
                        MinWidth="144"
                        Click="OnRetryClick"
                        Style="{StaticResource AetherEmphasisPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE72C;" />
                            <TextBlock x:Name="RetryLabel" Text="Retry" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="CopyDetailsButton"
                        MinWidth="144"
                        Click="OnCopyDetailsClick"
                        Style="{StaticResource AetherOutlinePillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE8C8;" />
                            <TextBlock x:Name="CopyDetailsLabel" Text="Copy details" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel
                    x:Name="StreamFailureActions"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Button
                        x:Name="StreamInstallButton"
                        MinWidth="150"
                        Click="OnStreamInstallClick"
                        Style="{StaticResource AetherEmphasisPillButtonStyle}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE896;" />
                            <TextBlock x:Name="StreamInstallLabel" Text="Install yt-dlp" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="StreamRetryButton"
                        MinWidth="120"
                        Click="OnStreamRetryClick"
                        Style="{StaticResource AetherEmphasisPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE72C;" />
                            <TextBlock x:Name="StreamRetryLabel" Text="Retry" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="StreamEditLinkButton"
                        MinWidth="120"
                        Click="OnStreamEditLinkClick"
                        Style="{StaticResource AetherOutlinePillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE70F;" />
                            <TextBlock x:Name="StreamEditLinkLabel" Text="Edit link" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="StreamOpenInBrowserButton"
                        MinWidth="150"
                        Click="OnStreamOpenInBrowserClick"
                        Style="{StaticResource AetherOutlinePillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{StaticResource AetherSizeIcon}"
                                Glyph="&#xE774;" />
                            <TextBlock x:Name="StreamOpenInBrowserLabel" Text="Open in browser" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="StreamFailureCancelButton"
                        MinWidth="100"
                        Click="OnStreamFailureCancelClick"
                        Style="{StaticResource AetherOutlinePillButtonStyle}">
                        <TextBlock x:Name="StreamFailureCancelLabel" Text="Cancel" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!--
                Status footer: reports the engine only, borderless on the backdrop. Dot, label and muted
                detail; startup work runs a 2 px bar along the bottom edge.
            -->
            <Border
                Grid.Row="1"
                Height="40"
                Padding="16,12"
                Margin="{StaticResource AetherPageMargin}">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="StatusDot"
                            Margin="0,5,0,0"
                            Style="{StaticResource AetherStatusDotStyle}" />
                        <TextBlock
                            x:Name="StatusLabel"
                            Foreground="{ThemeResource AetherTextPrimaryBrush}"
                            Style="{StaticResource AetherCaptionTextStyle}" />
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource AetherCaptionTextStyle}" />
                    </StackPanel>
                    <!--  The negative margin cancels the strip's padding so the bar sits on its bottom edge.  -->
                    <ProgressBar
                        x:Name="StartupProgress"
                        Height="2"
                        MinHeight="2"
                        Margin="-16,0,-16,-12"
                        VerticalAlignment="Bottom"
                        IsIndeterminate="True" />
                </Grid>
            </Border>
        </Grid>

        <!--  Drag-over: the drop-target fill and a 1 px border, inset 8 from the edges and below the title bar.  -->
        <Rectangle
            x:Name="DropOutline"
            Margin="8,40,8,8"
            Fill="{ThemeResource AetherFillDropTargetBrush}"
            IsHitTestVisible="False"
            RadiusX="8"
            RadiusY="8"
            Stroke="{ThemeResource AetherStrokeDropTargetBrush}"
            StrokeThickness="1"
            Visibility="Collapsed" />

        <!--
            Top scrim, over video only: black 50% under the 32 px title bar, fading to 0 by 72 px, so
            the title text holds contrast over bright frames. It fades with the chrome.
        -->
        <Rectangle
            x:Name="TopScrim"
            Height="72"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="{StaticResource AetherSurfaceTopScrimColor}" />
                    <GradientStop Offset="0.4444" Color="{StaticResource AetherSurfaceTopScrimColor}" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--
            Picture in picture (8.1): over the edge-to-edge video, a 48 round play/pause in the centre and a thin
            progress line along the bottom edge (click to seek, no times). Fades with the chrome; the top shade is
            the TopScrim and "Back to full window" sits in the title bar.
        -->
        <Grid
            x:Name="PipChrome"
            RequestedTheme="Dark"
            Visibility="Collapsed">
            <Button
                x:Name="PipPlayPauseButton"
                Width="{StaticResource AetherSizePipPlay}"
                Height="{StaticResource AetherSizePipPlay}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="OnPlayPauseClick"
                Content="&#xF5B0;"
                CornerRadius="24"
                FontSize="{StaticResource AetherSizePipPlayIcon}"
                Style="{StaticResource AetherPlayButtonStyle}" />
            <Grid
                x:Name="PipSeekLine"
                Height="16"
                VerticalAlignment="Bottom"
                Background="Transparent"
                PointerPressed="OnPipSeekPressed">
                <Rectangle
                    Height="{StaticResource AetherSizePipSeekLine}"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource AetherFillProgressTrackBrush}" />
                <Rectangle
                    Height="{StaticResource AetherSizePipSeekLine}"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource AetherTextPrimaryBrush}"
                    RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform x:Name="PipSeekScale" ScaleX="0" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </Grid>

        <!--
            Settings (6.1): fills the window under the title bar, straight on the backdrop. Created on first open.
        -->
        <Border
            x:Name="SettingsHost"
            Margin="0,32,0,0"
            Visibility="Collapsed" />

        <!--
            Title bar: Back (settings only), name and release label (the drag region), the gear, then 138 px
            left clear for the system caption buttons. The buttons sit outside the drag region so they take clicks.
        -->
        <Grid
            x:Name="TitleBar"
            Height="{StaticResource AetherSizeTitleBar}"
            VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SettingsBackButton"
                Click="OnSettingsBackClick"
                Content="&#xE72B;"
                Style="{StaticResource AetherTitleBarButtonStyle}"
                Visibility="Collapsed" />
            <Grid
                x:Name="TitleBarDragArea"
                Grid.Column="1"
                Background="Transparent">
                <!--
                    Shared baseline at y 20: both texts trim to their baseline and sit on the panel's bottom edge.
                -->
                <StackPanel
                    x:Name="TitleText"
                    Height="20"
                    Margin="16,0,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="TitleAppName"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AetherCaptionStrongTextStyle}"
                        Text="Aether"
                        TextLineBounds="TrimToBaseline" />
                    <!--  Plain text, no pill (7.14): a muted dot and file name while a video is open, "Alpha" otherwise.  -->
                    <TextBlock
                        x:Name="TitleSeparator"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AetherCaptionTextStyle}"
                        Text="·"
                        TextLineBounds="TrimToBaseline"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="TitleBadgeText"
                        MaxWidth="{StaticResource AetherSizeBadgeMaxWidth}"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AetherCaptionTextStyle}"
                        Text="Alpha"
                        TextLineBounds="TrimToBaseline"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <Button
                x:Name="SettingsButton"
                Grid.Column="2"
                Click="OnSettingsClick"
                Content="&#xE713;"
                Style="{StaticResource AetherTitleBarButtonStyle}" />
            <!--  Picture in picture only, in place of the gear: back to the full window, beside the system Close.  -->
            <Button
                x:Name="PipBackButton"
                Grid.Column="2"
                Width="{StaticResource AetherSizePipBackButton}"
                Click="OnPipBackClick"
                Content="&#xEE47;"
                Style="{StaticResource AetherTitleBarButtonStyle}"
                Visibility="Collapsed" />
            <!--  The window sets the width to the system's real caption-button inset; 138 is the 100% default.  -->
            <Border
                x:Name="CaptionReserve"
                Grid.Column="3"
                Width="{StaticResource AetherSizeCaptionButtons}" />
        </Grid>

        <!--  Diagnostics (Ctrl+I): top-left, 16 in from the edge and under the 32 px title bar.  -->
        <controls:DiagnosticsPanel
            x:Name="Diagnostics"
            RequestedTheme="Dark"
            Margin="16,48,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed" />

        <!--
            Sidebar (P8.1). A 4 px hot zone on the left edge under the title bar wakes it: resting there shows the FillRange
            peek strip beside where the card will be and opens it after 150 ms, a click opens it at once. The card is a
            48 x 168 pill (padding 6 counting the stroke) on the bar's tint with the bar's blur behind it (the render
            thread draws that, ADR-0013); the page places it (MainPage.Rail.cs) and slides it in from the left edge.
        -->
        <Border
            x:Name="RailHotZone"
            Width="{StaticResource AetherSizeRailHotZone}"
            Margin="0,32,0,0"
            HorizontalAlignment="Left"
            Background="Transparent"
            PointerCanceled="OnRailHotZoneExited"
            PointerEntered="OnRailHotZoneEntered"
            PointerExited="OnRailHotZoneExited"
            Tapped="OnRailHotZoneTapped">
            <Border
                x:Name="RailPeek"
                Height="168"
                VerticalAlignment="Top"
                Background="{ThemeResource AetherFillRangeBrush}"
                CornerRadius="0,2,2,0"
                IsHitTestVisible="False"
                Opacity="0" />
        </Border>
        <Border
            x:Name="Rail"
            RequestedTheme="Dark"
            Width="{StaticResource AetherSizeSidebarWidth}"
            Height="168"
            Margin="16,40,0,0"
            Padding="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.LandmarkType="Navigation"
            Background="{ThemeResource AetherSurfaceOsdBrush}"
            BorderBrush="{ThemeResource AetherStrokeSurfaceBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AetherTransportCornerRadius}"
            PointerCanceled="OnRailPointerExited"
            PointerEntered="OnRailPointerEntered"
            PointerExited="OnRailPointerExited"
            Visibility="Collapsed">
            <StackPanel Spacing="4">
                <Button
                    x:Name="RailPlayer"
                    Click="OnRailPlayerClick"
                    Content="&#xE714;"
                    Style="{StaticResource AetherSidebarItemActiveStyle}" />
                <Button
                    x:Name="RailClips"
                    Click="OnRailClipsClick"
                    Content="&#xE8F1;"
                    Style="{StaticResource AetherSidebarItemStyle}" />
                <Button
                    x:Name="RailStream"
                    Click="OnRailStreamClick"
                    Content="&#xE774;"
                    Style="{StaticResource AetherSidebarItemStyle}" />
                <Button
                    x:Name="RailSettings"
                    Click="OnRailSettingsClick"
                    Content="&#xE713;"
                    Style="{StaticResource AetherSidebarItemStyle}" />
            </StackPanel>
        </Border>

        <!--
            Export chip and clip drawer (s5-03, 5.3): 8 above the card (24 + 88 + 8 = 120 over the full card, 80 over
            the slim pill; the page moves it as the card grows), right-aligned to it by sharing its width and margins.
            Fades with the controls.
        -->
        <Grid
            x:Name="ClipLayer"
            RequestedTheme="Dark"
            MaxWidth="{StaticResource AetherSizeOsdWidth}"
            Margin="16,0,16,120"
            VerticalAlignment="Bottom"
            PointerCanceled="OnOsdPointerExited"
            PointerEntered="OnOsdPointerEntered"
            PointerExited="OnOsdPointerExited"
            Visibility="Collapsed">
            <controls:ClipDrawer x:Name="ClipDrawer" />
        </Grid>

        <!--
            Transport card: the seek row, then the buttons, 4 apart. min(520, window - 32) wide and 88 tall:
            padding 8 (7 here, the 1 px stroke is the eighth), a 32 px seek row and a 36 px button row.
            A plain 62% ink tint with a hairline edge and radius 24. 24 above the bottom.
            While a video plays it shrinks to the 48 px slim pill (7.11, s5-08): padding 6, and the seek row slides down
            between Play and Mute while the other buttons fade (MainPage.Bar.cs). Both rows overlap in one grid for that.
            min(520, window - 32) fits every button at any width, so there is no narrow layout any more (5.7 retired).
        -->
        <Border
            x:Name="Osd"
            RequestedTheme="Dark"
            Height="{StaticResource AetherSizeOsdHeight}"
            MaxWidth="{StaticResource AetherSizeOsdWidth}"
            Margin="16,0,16,24"
            Padding="7"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AetherSurfaceOsdBrush}"
            BorderBrush="{ThemeResource AetherStrokeSurfaceBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource AetherTransportCornerRadius}"
            GettingFocus="OnOsdGettingFocus"
            LosingFocus="OnOsdLosingFocus"
            PointerEntered="OnOsdPointerEntered"
            PointerExited="OnOsdPointerExited"
            PointerCanceled="OnOsdPointerExited"
            PointerCaptureLost="OnOsdPointerExited"
            SizeChanged="OnOsdSizeChanged"
            Visibility="Collapsed">
            <Grid>
                <!--
                    Row 2, on the bottom edge: 1fr / auto / 1fr, so the centre group is truly centred; 4 apart inside each group.
                    Left: Open, Speed. Centre: Back 5 s, Play, Forward 5 s. Right: Mute, More, Full screen. Frame steps, Loop and
                    Always on top live in More (owner's call, Pass 7: the row read as crowded with them out).
                -->
                <Grid
                    x:Name="ButtonRow"
                    Height="{StaticResource AetherSizeTransportButton}"
                    VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        x:Name="LeftGroup"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="OpenButton"
                            Click="OnOpenButtonClick"
                            Content="&#xE838;"
                            Style="{StaticResource AetherTransportIconButtonStyle}"
                            ToolTipService.Placement="Top"
                            ToolTipService.ToolTip="Open file (Ctrl+O)">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout
                                    x:Name="OpenMenu"
                                    Closed="OnOpenMenuClosed"
                                    MenuFlyoutPresenterStyle="{StaticResource AetherMenuFlyoutPresenterStyle}"
                                    Opened="OnOpenMenuOpened"
                                    Placement="TopEdgeAlignedLeft">
                                    <MenuFlyoutItem
                                        x:Name="OpenMenuFileItem"
                                        Click="OnOpenFileClick"
                                        Style="{StaticResource AetherMenuItemStyle}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE838;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="OpenMenuUrlItem"
                                        Click="OnOpenUrlClick"
                                        Style="{StaticResource AetherMenuItemStyle}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE71B;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                        <Button
                            x:Name="SpeedButton"
                            Click="OnSpeedClick"
                            Content="1.0×"
                            Style="{StaticResource AetherSpeedPillButtonStyle}"
                            ToolTipService.Placement="Top">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout
                                    x:Name="SpeedMenu"
                                    Closed="OnSpeedMenuClosed"
                                    MenuFlyoutPresenterStyle="{StaticResource AetherMenuFlyoutPresenterStyle}"
                                    Opened="OnSpeedMenuOpened"
                                    Placement="TopEdgeAlignedLeft" />
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                        <!--  Links only (9.8): names the size playing, like Speed names the speed; its menu lists the link's sizes.  -->
                        <Button
                            x:Name="QualityButton"
                            Click="OnQualityClick"
                            Content="Auto"
                            Style="{StaticResource AetherSpeedPillButtonStyle}"
                            ToolTipService.Placement="Top"
                            Visibility="Collapsed">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout
                                    x:Name="QualityMenu"
                                    Closed="OnQualityMenuClosed"
                                    MenuFlyoutPresenterStyle="{StaticResource AetherMenuFlyoutPresenterStyle}"
                                    Opened="OnQualityMenuOpened"
                                    Placement="TopEdgeAlignedLeft" />
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                    </StackPanel>

                    <!--  Skip 5 s is Segoe Fluent's circular arrow with a "5" set inside it; the numbered Fluent skip glyphs only come as 10 and 30.  -->
                    <StackPanel
                        x:Name="CentreGroup"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="BackButton"
                            Click="OnBackClick"
                            Style="{StaticResource AetherTransportIconButtonStyle}"
                            ToolTipService.Placement="Top">
                            <Grid>
                                <FontIcon FontSize="{StaticResource AetherSizeTransportSkipIcon}" Glyph="&#xE777;" />
                                <TextBlock Style="{StaticResource AetherSkipDigitTextStyle}" Text="5" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="PlayPauseButton"
                            Click="OnPlayPauseClick"
                            Content="&#xF5B0;"
                            Style="{StaticResource AetherPlayButtonStyle}"
                            ToolTipService.Placement="Top"
                            ToolTipService.ToolTip="Play (Space)" />
                        <Button
                            x:Name="ForwardButton"
                            Click="OnForwardClick"
                            Style="{StaticResource AetherTransportIconButtonStyle}"
                            ToolTipService.Placement="Top">
                            <Grid>
                                <FontIcon FontSize="{StaticResource AetherSizeTransportSkipIcon}" Glyph="&#xE72C;" />
                                <TextBlock Style="{StaticResource AetherSkipDigitTextStyle}" Text="5" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel
                        x:Name="RightGroup"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <!--
                            Volume lives in a flyout (5.8): 72 px slider, thumb 12 white. Clicking mutes; the
                            flyout opens on hover, or pinned from right-click or Shift+F10 so the keyboard can
                            reach the slider.
                        -->
                        <Button
                            x:Name="VolumeButton"
                            Click="OnVolumeClick"
                            Content="&#xE767;"
                            ContextRequested="OnVolumeContextRequested"
                            PointerCanceled="OnVolumeButtonPointerExited"
                            PointerEntered="OnVolumeButtonPointerEntered"
                            PointerExited="OnVolumeButtonPointerExited"
                            Style="{StaticResource AetherTransportIconButtonStyle}"
                            ToolTipService.Placement="Top">
                            <FlyoutBase.AttachedFlyout>
                                <Flyout
                                    x:Name="VolumeFlyout"
                                    AllowFocusOnInteraction="False"
                                    Closed="OnVolumeFlyoutClosed"
                                    Opened="OnVolumeFlyoutOpened"
                                    Placement="Top">
                                    <Flyout.FlyoutPresenterStyle>
                                        <!--  The 62% dialog tint; the blur behind it is drawn by the render thread (ADR-0013).  -->
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="RequestedTheme" Value="Dark" />
                                            <Setter Property="Background" Value="{ThemeResource AetherSurfaceDialogBrush}" />
                                            <Setter Property="BorderBrush" Value="{ThemeResource AetherStrokeSurfaceBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="{StaticResource AetherOverlayCornerRadius}" />
                                            <Setter Property="Padding" Value="12,0" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <Grid
                                        x:Name="VolumeFlyoutContent"
                                        RequestedTheme="Dark"
                                        Background="Transparent"
                                        PointerCanceled="OnVolumeFlyoutPointerExited"
                                        PointerEntered="OnVolumeFlyoutPointerEntered"
                                        PointerExited="OnVolumeFlyoutPointerExited">
                                        <Slider
                                            x:Name="VolumeSlider"
                                            Width="{StaticResource AetherSizeVolumeSlider}"
                                            VerticalAlignment="Center"
                                            AllowFocusOnInteraction="False"
                                            IsThumbToolTipEnabled="False"
                                            Maximum="100"
                                            Minimum="0"
                                            ValueChanged="OnVolumeChanged"
                                            Value="100">
                                            <Slider.Resources>
                                                <SolidColorBrush x:Key="SliderTrackFill" Color="{ThemeResource AetherFillRangeColor}" />
                                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{ThemeResource AetherFillRangeColor}" />
                                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{ThemeResource AetherFillRangeColor}" />
                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource AetherTextPrimaryColor}" />
                                                <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
                                                <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
                                                <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
                                                <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
                                                <x:Double x:Key="SliderInnerThumbWidth">12</x:Double>
                                                <x:Double x:Key="SliderInnerThumbHeight">12</x:Double>
                                            </Slider.Resources>
                                        </Slider>
                                    </Grid>
                                </Flyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                        <Button
                            x:Name="MoreButton"
                            Click="OnMoreClick"
                            Content="&#xE712;"
                            Style="{StaticResource AetherTransportIconButtonStyle}"
                            ToolTipService.Placement="Top">
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout
                                    x:Name="MoreMenu"
                                    Closed="OnMoreMenuClosed"
                                    MenuFlyoutPresenterStyle="{StaticResource AetherMenuFlyoutPresenterStyle}"
                                    Opened="OnMoreMenuOpened"
                                    Placement="TopEdgeAlignedRight">
                                    <MenuFlyoutItem
                                        x:Name="MoreAudioItem"
                                        Click="OnTracksMenuClick"
                                        Style="{StaticResource AetherMenuItemStyle}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE767;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="MoreSubtitlesItem"
                                        Click="OnTracksMenuClick"
                                        Style="{StaticResource AetherMenuItemStyle}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE7F0;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <ToggleMenuFlyoutItem
                                        x:Name="MoreLoopItem"
                                        Click="OnLoopClick"
                                        Style="{StaticResource AetherToggleMenuItemStyle}">
                                        <ToggleMenuFlyoutItem.Icon>
                                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE8EE;" />
                                        </ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <ToggleMenuFlyoutItem
                                        x:Name="MoreAlwaysOnTopItem"
                                        Click="OnAlwaysOnTopClick"
                                        Style="{StaticResource AetherToggleMenuItemStyle}">
                                        <ToggleMenuFlyoutItem.Icon>
                                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE718;" />
                                        </ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Name="MoreSettingsItem"
                                        Click="OnSettingsMenuClick"
                                        Style="{StaticResource AetherMenuItemStyle}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE713;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                        </Button>
                        <Button
                            x:Name="FullScreenButton"
                            Click="OnFullScreenClick"
                            Content="&#xE9A6;"
                            Style="{StaticResource AetherTransportIconButtonStyle}"
                            ToolTipService.Placement="Top"
                            ToolTipService.ToolTip="Full screen (F)" />
                    </StackPanel>
                </Grid>

                <!--
                    Row 1: current time, bar, duration, 12 apart and 8 in from the padding. TextPrimary only on the pill.
                    Last, so it stays on top of the buttons it slides between in the slim pill.
                -->
                <Grid
                    x:Name="SeekRow"
                    Height="{StaticResource AetherSizeSeekHitArea}"
                    Padding="8,0"
                    VerticalAlignment="Top"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PositionText"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherTimecodeTextStyle}"
                        Text="00:00" />
                    <controls:PrecisionSeekBar x:Name="SeekBar" Grid.Column="1" />
                    <TextBlock
                        x:Name="DurationText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherTimecodeSecondaryTextStyle}"
                        Text="00:00" />
                </Grid>
            </Grid>
        </Border>

        <!--
            Skip chapter (9.7): a prompt while a chapter to skip plays and auto-skip is off. Bottom right, 16 in from the
            edge like the other layers, clear of the sidebar card (top left); the page keeps its bottom in step with the
            toasts' and lifts it over a toast it would touch. The bar's tint and hairline, as a 36 px pill.
        -->
        <Grid
            x:Name="SkipChapterLayer"
            RequestedTheme="Dark"
            Margin="16,0,16,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            PointerCanceled="OnSkipChapterPointerExited"
            PointerEntered="OnSkipChapterPointerEntered"
            PointerExited="OnSkipChapterPointerExited"
            Visibility="Collapsed">
            <Button
                x:Name="SkipChapterButton"
                Height="{StaticResource AetherSizeTransportButton}"
                Padding="12,0,14,0"
                Background="{ThemeResource AetherSurfaceOsdBrush}"
                BorderBrush="{ThemeResource AetherStrokeSurfaceBrush}"
                Click="OnSkipChapterClick"
                Style="{StaticResource AetherOutlinePillButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="{StaticResource AetherSizeIcon}"
                        Glyph="&#xE893;" />
                    <!--  Body size like the button label it replaces, but SemiBold; no shared style is body-sized and bold.  -->
                    <TextBlock
                        x:Name="SkipChapterText"
                        MaxWidth="220"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </Grid>

        <!--
            Toasts (screen 10): bottom centre, min(360, window - 32) wide. The margin below follows the controls
            (ToastService.SetControlsShown); the page code fills in the toast.
        -->
        <Grid
            x:Name="ToastLayer"
            RequestedTheme="Dark"
            Margin="16,0,16,24"
            VerticalAlignment="Bottom"
            Visibility="Collapsed">
            <controls:Toast x:Name="ToastCard" />
        </Grid>

        <!--
            Open URL (2.5): scrim over the whole window, the strip dimmed with everything else. The
            dialog is min(440, window - 32) wide with padding 24, on the solid dialog fallback because
            it can sit over the swap chain (ADR-0013). Play (Emphasis) left, Cancel right, equal halves.
        -->
        <Grid
            x:Name="OpenUrlOverlay"
            Background="{ThemeResource AetherSurfaceScrimBrush}"
            Visibility="Collapsed">
            <Border
                x:Name="OpenUrlCard"
                MaxWidth="{StaticResource AetherSizeDialogWidth}"
                Margin="16"
                Padding="24"
                VerticalAlignment="Center"
                Background="{ThemeResource AetherSurfaceDialogBrush}"
                BorderBrush="{ThemeResource AetherStrokeSurfaceBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AetherOverlayCornerRadius}">
                <StackPanel TabFocusNavigation="Cycle">
                    <TextBlock
                        x:Name="OpenUrlTitle"
                        Style="{StaticResource AetherSubtitleTextStyle}"
                        Text="Open URL" />
                    <TextBlock
                        x:Name="OpenUrlFieldLabel"
                        Margin="0,16,0,0"
                        Style="{StaticResource AetherBodyTextStyle}"
                        Text="Video or stream link" />
                    <TextBox
                        x:Name="OpenUrlBox"
                        Margin="0,8,0,0"
                        Background="{ThemeResource AetherFillInputBrush}"
                        InputScope="Url"
                        IsSpellCheckEnabled="False"
                        KeyDown="OnOpenUrlBoxKeyDown"
                        TextChanged="OnOpenUrlTextChanged" />
                    <!--  The hint, or a dot and the reason (Caption; the dot sits on the caption line).  -->
                    <StackPanel
                        Margin="0,8,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Ellipse
                            x:Name="OpenUrlNoteDot"
                            Margin="0,5,0,0"
                            Style="{StaticResource AetherStatusDotStyle}"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="OpenUrlNoteText"
                            Style="{StaticResource AetherCaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Margin="0,24,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="OpenUrlPlayButton"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenUrlPlayClick"
                            IsEnabled="False"
                            Style="{StaticResource AetherEmphasisPillButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="{StaticResource AetherSizeIcon}"
                                    Glyph="&#xE768;" />
                                <TextBlock x:Name="OpenUrlPlayLabel" Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="OpenUrlCancelButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenUrlCancelClick"
                            Content="Cancel"
                            Style="{StaticResource AetherOutlinePillButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!--
            Phone pairing (11.3): the Open URL card over the same light scrim, so the video stays visible. Esc, the
            shortcut or a click outside the card closes it. The code sits on white in every theme.
        -->
        <Grid
            x:Name="LanStreamOverlay"
            RequestedTheme="Dark"
            Background="{ThemeResource AetherSurfaceScrimBrush}"
            PointerPressed="OnLanStreamOverlayPointerPressed"
            Visibility="Collapsed">
            <Border
                x:Name="LanStreamCard"
                MaxWidth="{StaticResource AetherSizeDialogWidth}"
                Margin="16"
                Padding="24"
                VerticalAlignment="Center"
                Background="{ThemeResource AetherSurfaceDialogBrush}"
                BorderBrush="{ThemeResource AetherStrokeSurfaceBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AetherOverlayCornerRadius}">
                <StackPanel TabFocusNavigation="Cycle">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LanStreamTitle" Style="{StaticResource AetherSubtitleTextStyle}" />
                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Ellipse
                                    x:Name="LanStreamStatusDot"
                                    Margin="0,5,0,0"
                                    Style="{StaticResource AetherStatusDotStyle}" />
                                <TextBlock x:Name="LanStreamStatusText" Style="{StaticResource AetherCaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="LanStreamSwitch"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource AetherSettingsToggleStyle}"
                            Toggled="OnLanStreamToggled" />
                    </Grid>
                    <Grid
                        Width="{StaticResource AetherSizeLanCode}"
                        Height="{StaticResource AetherSizeLanCode}"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center">
                        <Border
                            x:Name="LanStreamCodeOff"
                            Padding="16"
                            Background="{ThemeResource AetherFillInputBrush}"
                            BorderBrush="{ThemeResource AetherStrokeSurfaceBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AetherOverlayCornerRadius}">
                            <StackPanel VerticalAlignment="Center" Spacing="12">
                                <FontIcon
                                    FontSize="{StaticResource AetherSizeHeroGlyph}"
                                    Foreground="{ThemeResource AetherTextTertiaryBrush}"
                                    Glyph="&#xE8EA;" />
                                <TextBlock
                                    x:Name="LanStreamCodeOffText"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource AetherCaptionTextStyle}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="LanStreamCodeTile"
                            Background="{ThemeResource AetherSurfaceCodeBrush}"
                            CornerRadius="{StaticResource AetherOverlayCornerRadius}"
                            Visibility="Collapsed">
                            <!--  Sized in code to the bitmap's own pixels: one image pixel per screen pixel keeps every module sharp.  -->
                            <Image
                                x:Name="LanStreamCode"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform" />
                        </Border>
                    </Grid>
                    <Grid
                        x:Name="LanStreamAddressRow"
                        Margin="0,16,0,0"
                        ColumnSpacing="8"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="LanStreamAddress"
                            VerticalAlignment="Center"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource AetherSecondaryTextStyle}" />
                        <Button
                            x:Name="LanStreamCopyButton"
                            Grid.Column="1"
                            Click="OnLanStreamCopyClick"
                            Style="{StaticResource AetherOutlinePillButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="{StaticResource AetherSizeIcon}" Glyph="&#xE8C8;" />
                                <TextBlock x:Name="LanStreamCopyLabel" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!--  A reason or a problem; the dot only for a problem (Caption; the dot sits on the caption line).  -->
                    <Grid
                        x:Name="LanStreamNote"
                        Margin="0,16,0,0"
                        ColumnSpacing="8"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="LanStreamNoteDot"
                            Margin="0,5,0,0"
                            Fill="{ThemeResource AetherStatusWarningBrush}"
                            Style="{StaticResource AetherStatusDotStyle}" />
                        <TextBlock
                            x:Name="LanStreamNoteText"
                            Grid.Column="1"
                            Foreground="{ThemeResource AetherTextPrimaryBrush}"
                            Style="{StaticResource AetherCaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock
                        x:Name="LanStreamHint"
                        Margin="0,16,0,0"
                        Style="{StaticResource AetherCaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!--
            First-run tour (7.26, docs/reviews/pass-7-first-run-tour-spec.md). The scrim starts under the title bar,
            which stays live; its hole and the ring are placed per frame from MainPage.Tour.cs as the light moves. The
            blocker keeps clicks off the controls underneath. The card is placed beside each target in code.
        -->
        <Grid
            x:Name="TourLayer"
            SizeChanged="OnTourLayerSizeChanged"
            Visibility="Collapsed">
            <Border x:Name="TourBlocker" Background="Transparent" />
            <Path
                x:Name="TourScrim"
                Fill="{ThemeResource AetherSurfaceScrimBrush}"
                IsHitTestVisible="False" />
            <Rectangle
                x:Name="TourRing"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Stroke="{ThemeResource AetherStrokeInputFocusBrush}"
                StrokeThickness="2" />
            <Border
                x:Name="TourCard"
                Width="{StaticResource AetherSizeTourCard}"
                Padding="16"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource AetherSurfaceDialogFallbackBrush}"
                BorderBrush="{ThemeResource AetherStrokeSurfaceBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AetherOverlayCornerRadius}"
                KeyDown="OnTourCardKeyDown"
                SizeChanged="OnTourCardSizeChanged">
                <StackPanel TabFocusNavigation="Cycle">
                    <Grid>
                        <TextBlock
                            x:Name="TourProgress"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AetherTextSecondaryBrush}"
                            Style="{StaticResource AetherCaptionTextStyle}" />
                        <Button
                            x:Name="TourSkipButton"
                            Margin="0,0,-4,0"
                            Padding="12,0"
                            HorizontalAlignment="Right"
                            AllowFocusOnInteraction="True"
                            BorderBrush="Transparent"
                            Click="OnTourSkipClick"
                            FontSize="{StaticResource AetherCaptionFontSize}"
                            Foreground="{ThemeResource AetherTextSecondaryBrush}"
                            Style="{StaticResource AetherOutlinePillButtonStyle}" />
                    </Grid>
                    <StackPanel x:Name="TourContent" Margin="0,12,0,0" Spacing="4">
                        <TextBlock
                            x:Name="TourTitle"
                            Style="{StaticResource AetherSubtitleTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TourBody"
                            Foreground="{ThemeResource AetherTextSecondaryBrush}"
                            Style="{StaticResource AetherBodyTextStyle}"
                            TextWrapping="Wrap" />
                        <StackPanel
                            x:Name="TourKeys"
                            Margin="0,8,0,0"
                            Spacing="6"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Grid Margin="0,16,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="TourBar"
                            Width="96"
                            Height="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Border Background="{ThemeResource AetherTextTertiaryBrush}" CornerRadius="2" Opacity="0.4" />
                            <Border
                                x:Name="TourBarFill"
                                Background="{ThemeResource AetherTextPrimaryBrush}"
                                CornerRadius="2" />
                        </Grid>
                        <Button
                            x:Name="TourBackButton"
                            Grid.Column="1"
                            AllowFocusOnInteraction="True"
                            Click="OnTourBackClick"
                            Style="{StaticResource AetherOutlinePillButtonStyle}" />
                        <Button
                            x:Name="TourNextButton"
                            Grid.Column="2"
                            AllowFocusOnInteraction="True"
                            Click="OnTourNextClick"
                            Style="{StaticResource AetherEmphasisPillButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
