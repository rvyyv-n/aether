<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    RequestedTheme="Dark"
    x:Class="Aether_App.Controls.ClipDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Export chip (s5-03) and clip drawer (5.3, 5.4). The chip is a 40 tall pill on the transport card's
        Acrylic: padding 3 plus the 1 px stroke around 32 px controls, radius 12 (the 8 px buttons plus the inset). Opening the drawer grows the same surface upward to
        360 wide: three 52 px rows (more scroll), a quiet "Show all in folder" link, a divider, then the chip.
    -->
    <Border
        x:Name="Panel"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Padding="3"
        Background="{ThemeResource AetherSurfaceOsdBrush}"
        BorderBrush="{ThemeResource AetherStrokeSurfaceBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel>
            <StackPanel x:Name="DrawerArea" Visibility="Collapsed">
                <Grid
                    x:Name="OptionsBlock"
                    Padding="9,8,6,8"
                    ColumnSpacing="12"
                    RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="ModeLabel"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherCaptionStrongTextStyle}" />
                    <ListBox
                        x:Name="ModeList"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnModeChanged"
                        Style="{StaticResource AetherSegmentedStyle}" />

                    <TextBlock
                        x:Name="SizeLabel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherCaptionStrongTextStyle}" />
                    <ComboBox
                        x:Name="SizeCombo"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnSizeChanged"
                        Style="{StaticResource AetherSettingsComboStyle}" />

                    <StackPanel
                        x:Name="CustomRow"
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBox
                            x:Name="CustomBox"
                            Width="72"
                            BeforeTextChanging="OnCustomBeforeTextChanging"
                            InputScope="Number"
                            LostFocus="OnCustomLostFocus"
                            MaxLength="4"
                            Style="{StaticResource AetherSettingsTextBoxStyle}"
                            TextChanged="OnCustomTextChanged" />
                        <TextBlock
                            x:Name="CustomUnit"
                            VerticalAlignment="Center"
                            Style="{StaticResource AetherCaptionTextStyle}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="LookLabel"
                        Grid.Row="3"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherCaptionStrongTextStyle}" />
                    <ToggleSwitch
                        x:Name="LookToggle"
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource AetherSettingsToggleStyle}"
                        Toggled="OnLookToggled" />

                    <TextBlock
                        x:Name="HintText"
                        Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource AetherCaptionTextStyle}"
                        TextWrapping="Wrap" />
                </Grid>
                <Border
                    Height="1"
                    Margin="-3,0,-3,0"
                    Background="{ThemeResource AetherStrokeDividerBrush}" />
                <ScrollViewer
                    x:Name="RowsScroller"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RowsPanel" Padding="0,1,0,0" />
                </ScrollViewer>
                <Button
                    x:Name="ShowAllButton"
                    Margin="6,4,0,4"
                    Padding="8,0"
                    Click="OnShowAllClick"
                    FontSize="{StaticResource AetherCaptionFontSize}"
                    Foreground="{ThemeResource AetherTextSecondaryBrush}"
                    Style="{StaticResource AetherIconButtonStyle}"
                    Width="Auto" />
                <Border
                    Height="1"
                    Margin="-3,0,-3,3"
                    Background="{ThemeResource AetherStrokeDividerBrush}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">
                <TextBlock
                    x:Name="RangeText"
                    Margin="9,0,4,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource AetherCaptionTextStyle}"
                    Foreground="{ThemeResource AetherTextPrimaryBrush}" />
                <Button
                    x:Name="ExportButton"
                    Height="{StaticResource AetherSizeControl}"
                    Click="OnExportClick"
                    FontSize="{StaticResource AetherCaptionFontSize}"
                    Style="{StaticResource AetherEmphasisPillButtonStyle}" />
                <Button
                    x:Name="ClearButton"
                    Click="OnClearClick"
                    Content="&#xE711;"
                    Style="{StaticResource AetherIconButtonStyle}"
                    ToolTipService.Placement="Top" />
                <ToggleButton
                    x:Name="ClipsToggle"
                    Width="Auto"
                    MinWidth="{StaticResource AetherSizeControl}"
                    Padding="8,0"
                    Click="OnClipsToggleClick"
                    Style="{StaticResource AetherIconToggleButtonStyle}"
                    ToolTipService.Placement="Top">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            x:Name="ClipsText"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource AetherUiFont}"
                            FontSize="{StaticResource AetherCaptionFontSize}" />
                        <FontIcon
                            x:Name="Chevron"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="&#xE70E;" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
