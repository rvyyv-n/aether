<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Aether_App.Controls.PrecisionSeekBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!--
        Seek row bar (screen 5): the whole 32 px row is the hit area, the 4 px track is centred in it.
        Back to front: in/out band (20 px, FillRange, radius 4), track (ProgressTrack 12%), buffered
        (FillRange 20%), played (white), in/out ticks (2×24 white), pointer line (1×16 TextSecondary),
        thumb (12 white with a black 20% ring, 16 while dragging). Positions are set from code.
    -->
    <Grid
        x:Name="Root"
        Height="{StaticResource AetherSizeSeekHitArea}"
        Background="Transparent"
        PointerCanceled="OnPointerCaptureEnded"
        PointerCaptureLost="OnPointerCaptureEnded"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        PointerMoved="OnPointerMoved"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        SizeChanged="OnSizeChanged">
        <Canvas x:Name="Layer">
            <Border
                x:Name="Band"
                Canvas.Top="6"
                Height="{StaticResource AetherSizeClipRange}"
                Background="{StaticResource AetherFillRangeBrush}"
                CornerRadius="{StaticResource AetherControlCornerRadius}"
                Visibility="Collapsed" />
            <Border
                x:Name="Track"
                Canvas.Top="14"
                Height="4"
                Background="{StaticResource AetherFillProgressTrackBrush}"
                CornerRadius="2" />
            <Border
                x:Name="Buffered"
                Canvas.Top="14"
                Height="4"
                Background="{StaticResource AetherFillRangeBrush}"
                CornerRadius="2"
                Visibility="Collapsed" />
            <Border
                x:Name="Played"
                Canvas.Top="14"
                Height="4"
                Background="{StaticResource AetherTextPrimaryBrush}"
                CornerRadius="2" />
            <Rectangle
                x:Name="InTick"
                Canvas.Top="4"
                Width="2"
                Height="24"
                Fill="{StaticResource AetherTextPrimaryBrush}"
                Visibility="Collapsed" />
            <Rectangle
                x:Name="OutTick"
                Canvas.Top="4"
                Width="2"
                Height="24"
                Fill="{StaticResource AetherTextPrimaryBrush}"
                Visibility="Collapsed" />
            <Rectangle
                x:Name="HoverLine"
                Canvas.Top="8"
                Width="1"
                Height="16"
                Fill="{StaticResource AetherTextSecondaryBrush}"
                Visibility="Collapsed" />
            <Ellipse
                x:Name="Thumb"
                Width="{StaticResource AetherSizeSeekThumb}"
                Height="{StaticResource AetherSizeSeekThumb}"
                Fill="{StaticResource AetherTextPrimaryBrush}"
                Stroke="#33000000"
                StrokeThickness="1"
                Visibility="Collapsed" />
        </Canvas>

        <!--
            Time bubble, 16 above the pill (BubbleLift is measured from the bar's top). Solid dialog
            fallback: in-app Acrylic would not sample the swap chain under it (ADR-0013). Padding 4,8
            less the hairline.
        -->
        <Popup
            x:Name="BubblePopup"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            ShouldConstrainToRootBounds="True">
            <Border
                x:Name="Bubble"
                Padding="7,3"
                Background="{StaticResource AetherSurfaceDialogFallbackBrush}"
                BorderBrush="{StaticResource AetherStrokeSurfaceBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AetherControlCornerRadius}"
                IsHitTestVisible="False">
                <TextBlock x:Name="BubbleText" Style="{StaticResource AetherTimecodeTextStyle}" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
