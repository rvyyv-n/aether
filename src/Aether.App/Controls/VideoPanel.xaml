<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Aether_App.Controls.VideoPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Video flyout (screen 9.3): 340 wide, padding 12,16. Zoom with its readout and Reset, Rotate as a segmented control,
        Aspect ratio as a combo, then the four colour sliders with Reset colours and, under a divider, the Look (grade,
        sharpen, grain, denoise, Reset look). The flyout supplies the solid surface
        (ADR-0013); the scroll area keeps it inside a short window (9.5).
    -->
    <ScrollViewer
        x:Name="Scroller"
        Width="{StaticResource AetherSizeVideoFlyout}"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12" Spacing="12">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ZoomLabel"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherCaptionStrongTextStyle}" />
                    <TextBlock
                        x:Name="ZoomValue"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherBodyTextStyle}"
                        Typography.NumeralAlignment="Tabular" />
                    <Button
                        x:Name="ZoomResetButton"
                        Grid.Column="2"
                        Click="OnZoomResetClick"
                        Style="{StaticResource AetherSettingsTextButtonStyle}" />
                </Grid>
                <Slider
                    x:Name="ZoomSlider"
                    Width="Auto"
                    IsThumbToolTipEnabled="False"
                    Maximum="400"
                    Minimum="25"
                    SmallChange="5"
                    StepFrequency="5"
                    Style="{StaticResource AetherSettingsSliderStyle}"
                    ValueChanged="OnZoomChanged" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Name="RotateLabel" Style="{StaticResource AetherCaptionStrongTextStyle}" />
                <ListBox
                    x:Name="RotateList"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnRotateChanged"
                    Style="{StaticResource AetherSegmentedStyle}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Name="AspectLabel" Style="{StaticResource AetherCaptionStrongTextStyle}" />
                <ComboBox
                    x:Name="AspectCombo"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnAspectChanged"
                    Style="{StaticResource AetherSettingsComboStyle}" />
            </StackPanel>

            <StackPanel x:Name="ColourRows" Spacing="8" />

            <Button
                x:Name="ResetColoursButton"
                HorizontalAlignment="Left"
                Click="OnResetColoursClick"
                Style="{StaticResource AetherSettingsTextButtonStyle}" />

            <Border Height="1" Margin="-16,4,-16,4" Background="{ThemeResource AetherStrokeDividerBrush}" />
            <TextBlock x:Name="LookHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" />

            <StackPanel Spacing="4">
                <TextBlock x:Name="GradeLabel" Style="{StaticResource AetherCaptionStrongTextStyle}" />
                <ComboBox
                    x:Name="GradeCombo"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnGradeChanged"
                    Style="{StaticResource AetherSettingsComboStyle}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SharpenLabel" VerticalAlignment="Center" Style="{StaticResource AetherCaptionStrongTextStyle}" />
                    <TextBlock
                        x:Name="SharpenValue"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherBodyTextStyle}"
                        Typography.NumeralAlignment="Tabular" />
                </Grid>
                <Slider
                    x:Name="SharpenSlider"
                    Width="Auto"
                    IsThumbToolTipEnabled="False"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="5"
                    StepFrequency="5"
                    Style="{StaticResource AetherSettingsSliderStyle}"
                    ValueChanged="OnAmountChanged" />
            </StackPanel>

            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GrainLabel" VerticalAlignment="Center" Style="{StaticResource AetherCaptionStrongTextStyle}" />
                    <TextBlock
                        x:Name="GrainValue"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource AetherBodyTextStyle}"
                        Typography.NumeralAlignment="Tabular" />
                </Grid>
                <Slider
                    x:Name="GrainSlider"
                    Width="Auto"
                    IsThumbToolTipEnabled="False"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="5"
                    StepFrequency="5"
                    Style="{StaticResource AetherSettingsSliderStyle}"
                    ValueChanged="OnAmountChanged" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Name="DenoiseLabel" Style="{StaticResource AetherCaptionStrongTextStyle}" />
                <ListBox
                    x:Name="DenoiseList"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnDenoiseChanged"
                    Style="{StaticResource AetherSegmentedStyle}" />
                <TextBlock
                    x:Name="DenoiseHint"
                    Style="{StaticResource AetherCaptionTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Button
                x:Name="ResetLookButton"
                HorizontalAlignment="Left"
                Click="OnResetLookClick"
                Style="{StaticResource AetherSettingsTextButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
