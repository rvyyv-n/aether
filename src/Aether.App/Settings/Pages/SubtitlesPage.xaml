<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.SubtitlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <StackPanel Spacing="16">
        <StackPanel Spacing="8">
            <TextBlock x:Name="DefaultsHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="ShowSubtitlesRow">
                    <ToggleSwitch x:Name="ShowSubtitlesToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="SubtitleLanguageRow">
                    <ComboBox x:Name="SubtitleLanguageCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="AudioLanguageRow">
                    <ComboBox x:Name="AudioLanguageCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </settings:SettingsRow>
            </settings:SettingsGroup>
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock x:Name="FontHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="SubtitleFontRow">
                    <TextBox x:Name="SubtitleFontBox" MinWidth="200" MaxLength="256" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="SubtitleSizeRow">
                    <ListBox x:Name="SubtitleSizeSegmented" Style="{StaticResource AetherSegmentedStyle}" />
                </settings:SettingsRow>
            </settings:SettingsGroup>
        </StackPanel>
    </StackPanel>
</Page>
