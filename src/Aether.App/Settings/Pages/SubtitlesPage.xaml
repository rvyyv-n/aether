<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.SubtitlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <settings:SettingsGroup>
        <settings:SettingsRow x:Name="ShowSubtitlesRow" Glyph="&#xE7F0;">
            <ToggleSwitch x:Name="ShowSubtitlesToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="AudioLanguageRow" Glyph="&#xE774;">
            <ComboBox x:Name="AudioLanguageCombo" Style="{StaticResource AetherSettingsComboStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="SubtitleLanguageRow" Glyph="&#xE774;">
            <ComboBox x:Name="SubtitleLanguageCombo" Style="{StaticResource AetherSettingsComboStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="SubtitleFontRow" Glyph="&#xE8D2;">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="SubtitleFontCombo" MinWidth="180" IsEditable="True" Style="{StaticResource AetherSettingsComboStyle}" />
                <ComboBox x:Name="SubtitleSizeCombo" MinWidth="112" Style="{StaticResource AetherSettingsComboStyle}" />
            </StackPanel>
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="SubtitleLookRow" Glyph="&#xE790;">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="SubtitleColorCombo" MinWidth="112" Style="{StaticResource AetherSettingsComboStyle}" />
                <ComboBox x:Name="SubtitlePositionCombo" MinWidth="112" Style="{StaticResource AetherSettingsComboStyle}" />
            </StackPanel>
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="SubtitleBoldRow" Glyph="&#xE8DD;">
            <ToggleSwitch x:Name="SubtitleBoldToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="SubtitleOutlineRow" Glyph="&#xE7C6;">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="SubtitleOutlineCombo" MinWidth="112" Style="{StaticResource AetherSettingsComboStyle}" />
                <ComboBox x:Name="SubtitleOutlineColorCombo" MinWidth="112" Style="{StaticResource AetherSettingsComboStyle}" />
            </StackPanel>
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="SubtitleBackgroundRow" Glyph="&#xE91B;">
            <ComboBox x:Name="SubtitleBackgroundCombo" MinWidth="112" Style="{StaticResource AetherSettingsComboStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="SubtitleOverrideRow" Glyph="&#xE771;">
            <ToggleSwitch x:Name="SubtitleOverrideToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <Border x:Name="PreviewFrame" Padding="16" MinHeight="88" CornerRadius="8" Background="#FF1B1B1F">
            <Border x:Name="PreviewBox" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2" CornerRadius="3">
                <TextBlock x:Name="PreviewText" TextAlignment="Center" TextWrapping="Wrap" />
            </Border>
        </Border>
    </settings:SettingsGroup>
</Page>
