<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <StackPanel Spacing="16">
        <StackPanel Spacing="8">
            <TextBlock x:Name="QualityHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="QualityPresetRow">
                    <ListBox x:Name="QualityPresetSegmented" Style="{StaticResource AetherSegmentedStyle}" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="HardwareDecodingRow">
                    <ComboBox x:Name="HardwareDecodingCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </settings:SettingsRow>
                <TextBlock x:Name="HardwareDecodingRestartNote" Margin="16,0,16,12" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" />
                <settings:SettingsRow x:Name="SmoothMotionRow">
                    <ToggleSwitch x:Name="SmoothMotionToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
                </settings:SettingsRow>
            </settings:SettingsGroup>
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock x:Name="ScalingHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="UpscalingRow">
                    <ComboBox x:Name="UpscalingCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="DownscalingRow">
                    <ComboBox x:Name="DownscalingCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="DebandingRow">
                    <ToggleSwitch x:Name="DebandingToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="HdrToneMappingRow">
                    <ComboBox x:Name="HdrToneMappingCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </settings:SettingsRow>
            </settings:SettingsGroup>
        </StackPanel>
        <settings:SettingsGroup>
            <settings:SettingsExpander x:Name="AdjustmentsExpander">
                <settings:SettingsRow x:Name="BrightnessRow">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider x:Name="BrightnessSlider" Style="{StaticResource AetherSettingsSliderStyle}" Minimum="-100" Maximum="100" StepFrequency="1" />
                        <TextBlock x:Name="BrightnessValue" Width="32" VerticalAlignment="Center" HorizontalTextAlignment="Right" Style="{StaticResource AetherCaptionTextStyle}" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        <Button x:Name="BrightnessReset" Style="{StaticResource AetherIconButtonStyle}" Visibility="Collapsed">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE777;" />
                        </Button>
                    </StackPanel>
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="ContrastRow">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider x:Name="ContrastSlider" Style="{StaticResource AetherSettingsSliderStyle}" Minimum="-100" Maximum="100" StepFrequency="1" />
                        <TextBlock x:Name="ContrastValue" Width="32" VerticalAlignment="Center" HorizontalTextAlignment="Right" Style="{StaticResource AetherCaptionTextStyle}" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        <Button x:Name="ContrastReset" Style="{StaticResource AetherIconButtonStyle}" Visibility="Collapsed">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE777;" />
                        </Button>
                    </StackPanel>
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="GammaRow">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider x:Name="GammaSlider" Style="{StaticResource AetherSettingsSliderStyle}" Minimum="-100" Maximum="100" StepFrequency="1" />
                        <TextBlock x:Name="GammaValue" Width="32" VerticalAlignment="Center" HorizontalTextAlignment="Right" Style="{StaticResource AetherCaptionTextStyle}" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        <Button x:Name="GammaReset" Style="{StaticResource AetherIconButtonStyle}" Visibility="Collapsed">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE777;" />
                        </Button>
                    </StackPanel>
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="SaturationRow">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Slider x:Name="SaturationSlider" Style="{StaticResource AetherSettingsSliderStyle}" Minimum="-100" Maximum="100" StepFrequency="1" />
                        <TextBlock x:Name="SaturationValue" Width="32" VerticalAlignment="Center" HorizontalTextAlignment="Right" Style="{StaticResource AetherCaptionTextStyle}" Foreground="{StaticResource AetherTextSecondaryBrush}" />
                        <Button x:Name="SaturationReset" Style="{StaticResource AetherIconButtonStyle}" Visibility="Collapsed">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE777;" />
                        </Button>
                    </StackPanel>
                </settings:SettingsRow>
            </settings:SettingsExpander>
        </settings:SettingsGroup>
    </StackPanel>
</Page>
