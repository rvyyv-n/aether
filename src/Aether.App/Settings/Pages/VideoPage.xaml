<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <settings:SettingsGroup>
        <settings:SettingsRow x:Name="QualityPresetRow" Glyph="&#xE9E9;">
            <ListBox x:Name="QualityPresetSegmented" Style="{StaticResource AetherSegmentedStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="HardwareDecodingRow" Glyph="&#xE950;">
            <settings:SettingsRow.Note>
                <TextBlock x:Name="HardwareDecodingRestartNote" Margin="0,2,0,0" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" />
            </settings:SettingsRow.Note>
            <ComboBox x:Name="HardwareDecodingCombo" Style="{StaticResource AetherSettingsComboStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="SmoothMotionRow" Glyph="&#xEC4A;">
            <ToggleSwitch x:Name="SmoothMotionToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="DeinterlaceRow" Glyph="&#xE71C;">
            <ToggleSwitch x:Name="DeinterlaceToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="DeinterlaceModeRow" Glyph=" ">
            <ComboBox x:Name="DeinterlaceModeCombo" Style="{StaticResource AetherSettingsComboStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="AspectRatioRow" Glyph="&#xE799;">
            <ComboBox x:Name="AspectRatioCombo" Style="{StaticResource AetherSettingsComboStyle}" />
        </settings:SettingsRow>
        <settings:SettingsExpander x:Name="SnapshotsExpander" Glyph="&#xE722;">
            <settings:SettingsRow x:Name="ScreenshotDirectoryRow">
                <TextBox x:Name="ScreenshotDirectoryBox" Style="{StaticResource AetherSettingsTextBoxStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="ScreenshotFormatRow">
                <ComboBox x:Name="ScreenshotFormatCombo" Style="{StaticResource AetherSettingsComboStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="ScreenshotTemplateRow">
                <TextBox x:Name="ScreenshotTemplateBox" Style="{StaticResource AetherSettingsTextBoxStyle}" />
            </settings:SettingsRow>
        </settings:SettingsExpander>
        <settings:SettingsExpander x:Name="ScalingExpander" Glyph="&#xE740;">
            <settings:SettingsRow x:Name="UpscalingRow">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="UpscalingReset" Style="{StaticResource AetherSettingsTextButtonStyle}" />
                    <ComboBox x:Name="UpscalingCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </StackPanel>
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="DownscalingRow">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="DownscalingReset" Style="{StaticResource AetherSettingsTextButtonStyle}" />
                    <ComboBox x:Name="DownscalingCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </StackPanel>
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="DebandingRow">
                <ToggleSwitch x:Name="DebandingToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="HdrToneMappingRow">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="HdrToneMappingReset" Style="{StaticResource AetherSettingsTextButtonStyle}" />
                    <ComboBox x:Name="HdrToneMappingCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </StackPanel>
            </settings:SettingsRow>
        </settings:SettingsExpander>
        <settings:SettingsExpander x:Name="AdjustmentsExpander" Glyph="&#xE9E9;">
            <settings:SettingsRow x:Name="BrightnessRow">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Slider x:Name="BrightnessSlider" Style="{StaticResource AetherSettingsSliderStyle}" Minimum="-100" Maximum="100" StepFrequency="1" />
                    <TextBlock x:Name="BrightnessValue" Width="32" VerticalAlignment="Center" HorizontalTextAlignment="Right" Style="{StaticResource AetherBodyTextStyle}" />
                </StackPanel>
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="ContrastRow">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Slider x:Name="ContrastSlider" Style="{StaticResource AetherSettingsSliderStyle}" Minimum="-100" Maximum="100" StepFrequency="1" />
                    <TextBlock x:Name="ContrastValue" Width="32" VerticalAlignment="Center" HorizontalTextAlignment="Right" Style="{StaticResource AetherBodyTextStyle}" />
                </StackPanel>
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="GammaRow">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Slider x:Name="GammaSlider" Style="{StaticResource AetherSettingsSliderStyle}" Minimum="-100" Maximum="100" StepFrequency="1" />
                    <TextBlock x:Name="GammaValue" Width="32" VerticalAlignment="Center" HorizontalTextAlignment="Right" Style="{StaticResource AetherBodyTextStyle}" />
                </StackPanel>
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="SaturationRow">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Slider x:Name="SaturationSlider" Style="{StaticResource AetherSettingsSliderStyle}" Minimum="-100" Maximum="100" StepFrequency="1" />
                    <TextBlock x:Name="SaturationValue" Width="32" VerticalAlignment="Center" HorizontalTextAlignment="Right" Style="{StaticResource AetherBodyTextStyle}" />
                </StackPanel>
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="AdjustmentsResetRow">
                <Button x:Name="AdjustmentsReset" Style="{StaticResource AetherOutlinePillButtonStyle}" />
            </settings:SettingsRow>
        </settings:SettingsExpander>
    </settings:SettingsGroup>
</Page>
