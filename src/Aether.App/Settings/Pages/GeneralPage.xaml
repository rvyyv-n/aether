<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <StackPanel Spacing="16">
        <settings:SettingsGroup>
            <settings:SettingsRow x:Name="BatterySaverRow" Glyph="&#xE850;">
                <ToggleSwitch x:Name="BatterySaverToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="OpenInRunningWindowRow" Glyph="&#xE737;">
                <ToggleSwitch x:Name="OpenInRunningWindowToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
        </settings:SettingsGroup>
    </StackPanel>
</Page>
