<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <StackPanel Spacing="16">
        <StackPanel Padding="16,0" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="AppName" VerticalAlignment="Center" Style="{StaticResource AetherSubtitleTextStyle}" />
                <TextBlock x:Name="AppBadge" VerticalAlignment="Center" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" />
            </StackPanel>
            <TextBlock x:Name="AppVersion" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherBodyTextStyle}" />
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock x:Name="VersionsHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="MpvRow">
                    <TextBlock x:Name="MpvVersionText" VerticalAlignment="Center" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherBodyTextStyle}" IsTextSelectionEnabled="True" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="YtDlpRow">
                    <TextBlock x:Name="YtDlpVersionText" VerticalAlignment="Center" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherBodyTextStyle}" IsTextSelectionEnabled="True" />
                </settings:SettingsRow>
            </settings:SettingsGroup>
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock x:Name="SupportHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="DiagnosticsRow">
                    <Button x:Name="CopyDiagnosticsButton" Style="{StaticResource AetherOutlinePillButtonStyle}" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="LicencesRow">
                    <Button x:Name="LicencesButton" Style="{StaticResource AetherOutlinePillButtonStyle}" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="ReportIssueRow">
                    <Button x:Name="ReportIssueButton" Style="{StaticResource AetherOutlinePillButtonStyle}" />
                </settings:SettingsRow>
            </settings:SettingsGroup>
        </StackPanel>
    </StackPanel>
</Page>
