<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.PlaybackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <StackPanel Spacing="16">
        <settings:SettingsGroup>
            <settings:SettingsRow x:Name="PreciseSeekingRow" Glyph="&#xE72A;">
                <ToggleSwitch x:Name="PreciseSeekingToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="ResumePlaybackRow" Glyph="&#xE777;">
                <ToggleSwitch x:Name="ResumePlaybackToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="LoopByDefaultRow" Glyph="&#xE8EE;">
                <ToggleSwitch x:Name="LoopByDefaultToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="PlayNextInFolderRow" Glyph="&#xE893;">
                <ToggleSwitch x:Name="PlayNextInFolderToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="ChapterAutoSkipRow" Glyph="&#xE893;">
                <ToggleSwitch x:Name="ChapterAutoSkipToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="ChapterSkipNamesRow" Glyph="&#xE70F;">
                <TextBox x:Name="ChapterSkipNamesBox" Style="{StaticResource AetherSettingsTextBoxStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="PreventSleepRow" Glyph="&#xE706;">
                <ToggleSwitch x:Name="PreventSleepToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
        </settings:SettingsGroup>
    </StackPanel>
</Page>
