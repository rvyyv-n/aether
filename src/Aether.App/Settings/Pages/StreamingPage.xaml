<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.StreamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <StackPanel Spacing="16">
        <StackPanel Spacing="8">
            <TextBlock x:Name="YtDlpHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="YtDlpRow">
                    <Button x:Name="YtDlpDownloadButton" Style="{StaticResource AetherOutlinePillButtonStyle}" Visibility="Collapsed" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="YtDlpAutoUpdateRow">
                    <ToggleSwitch x:Name="YtDlpAutoUpdateToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
                </settings:SettingsRow>
            </settings:SettingsGroup>
            <TextBlock x:Name="YtDlpMissingNote" Margin="16,0" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock x:Name="StreamsHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="StreamingQualityRow">
                    <ComboBox x:Name="StreamingQualityCombo" Style="{StaticResource AetherSettingsComboStyle}" />
                </settings:SettingsRow>
                <settings:SettingsRow x:Name="PreferGpuDecodableFormatsRow">
                    <ToggleSwitch x:Name="PreferGpuDecodableFormatsToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
                </settings:SettingsRow>
            </settings:SettingsGroup>
        </StackPanel>
    </StackPanel>
</Page>
