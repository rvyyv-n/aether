<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.StreamingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <StackPanel Spacing="8">
        <settings:SettingsGroup>
            <settings:SettingsRow x:Name="StreamingQualityRow" Glyph="&#xE93E;">
                <ComboBox x:Name="StreamingQualityCombo" Style="{StaticResource AetherSettingsComboStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="PreferGpuDecodableFormatsRow" Glyph="&#xE964;">
                <ToggleSwitch x:Name="PreferGpuDecodableFormatsToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="YtDlpRow" Glyph="&#xE896;">
                <Button x:Name="YtDlpActionButton" Style="{StaticResource AetherOutlinePillButtonStyle}" Visibility="Collapsed" />
            </settings:SettingsRow>
            <!--  A blank glyph keeps the title in line with yt-dlp's, the setting it belongs to  -->
            <settings:SettingsRow x:Name="YtDlpAutoUpdateRow" Glyph=" ">
                <ToggleSwitch x:Name="YtDlpAutoUpdateToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
        </settings:SettingsGroup>
        <TextBlock x:Name="YtDlpMissingNote" Margin="16,0" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</Page>
