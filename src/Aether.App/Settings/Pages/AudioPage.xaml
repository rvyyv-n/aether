<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <StackPanel Spacing="16">
        <settings:SettingsGroup>
            <settings:SettingsRow x:Name="AudioOutputDeviceRow">
                <ComboBox x:Name="AudioOutputDeviceCombo" Style="{StaticResource AetherSettingsComboStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="ExclusiveModeRow">
                <ToggleSwitch x:Name="ExclusiveModeToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <settings:SettingsRow x:Name="PassthroughRow">
                <ToggleSwitch x:Name="PassthroughToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
            <TextBlock x:Name="PassthroughRestartNote" Margin="16,0,16,12" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" />
            <settings:SettingsRow x:Name="VolumeNormalisationRow">
                <ToggleSwitch x:Name="VolumeNormalisationToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
            </settings:SettingsRow>
        </settings:SettingsGroup>
    </StackPanel>
</Page>
