<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <settings:SettingsGroup>
        <settings:SettingsRow x:Name="AudioOutputDeviceRow" Glyph="&#xE7F6;">
            <ComboBox x:Name="AudioOutputDeviceCombo" Style="{StaticResource AetherSettingsComboStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="ExclusiveModeRow" Glyph="&#xE994;">
            <ToggleSwitch x:Name="ExclusiveModeToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="PassthroughRow" Glyph="&#xE994;">
            <settings:SettingsRow.Note>
                <TextBlock x:Name="PassthroughRestartNote" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" />
            </settings:SettingsRow.Note>
            <ToggleSwitch x:Name="PassthroughToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="PitchCorrectionRow" Glyph="&#xE8D6;">
            <ToggleSwitch x:Name="PitchCorrectionToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="StereoDownmixRow" Glyph="&#xE994;">
            <ToggleSwitch x:Name="StereoDownmixToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="VolumeNormalisationRow" Glyph="&#xE9E9;">
            <ToggleSwitch x:Name="VolumeNormalisationToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
    </settings:SettingsGroup>
</Page>
