<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <StackPanel Spacing="16">
        <StackPanel Spacing="8">
            <TextBlock x:Name="EngineHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="CustomOptionsRow" />
                <StackPanel Padding="16,0,16,16" Spacing="8">
                    <TextBox
                        x:Name="CustomOptionsBox"
                        AcceptsReturn="True"
                        MaxLength="8192"
                        Style="{StaticResource AetherCustomOptionsTextBoxStyle}" />
                    <StackPanel x:Name="CustomOptionsErrors" Spacing="2" />
                    <TextBlock x:Name="CustomOptionsRestartNote" Foreground="{StaticResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </settings:SettingsGroup>
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock x:Name="ResetHeading" Style="{StaticResource AetherCaptionStrongTextStyle}" AutomationProperties.HeadingLevel="Level2" />
            <settings:SettingsGroup>
                <settings:SettingsRow x:Name="ResetAllRow">
                    <Button x:Name="ResetAllButton" Style="{StaticResource AetherOutlinePillButtonStyle}" />
                </settings:SettingsRow>
            </settings:SettingsGroup>
        </StackPanel>
    </StackPanel>
</Page>
