<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Aether_App.Settings.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">
    <settings:SettingsGroup>
        <settings:SettingsRow x:Name="RepairAviIndexRow" Glyph="&#xE90F;">
            <settings:SettingsRow.Note>
                <TextBlock x:Name="RepairAviIndexRestartNote" Margin="0,2,0,0" Foreground="{ThemeResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" />
            </settings:SettingsRow.Note>
            <ToggleSwitch x:Name="RepairAviIndexToggle" Style="{StaticResource AetherSettingsToggleStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="SkipDeblockingRow" Glyph="&#xE713;">
            <settings:SettingsRow.Note>
                <TextBlock x:Name="SkipDeblockingRestartNote" Margin="0,2,0,0" Foreground="{ThemeResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" />
            </settings:SettingsRow.Note>
            <ComboBox x:Name="SkipDeblockingCombo" Style="{StaticResource AetherSettingsComboStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="CustomOptionsRow" Glyph="&#xE943;">
            <settings:SettingsRow.Note>
                <StackPanel Margin="0,12,0,0" Spacing="8">
                    <TextBox
                        x:Name="CustomOptionsBox"
                        AcceptsReturn="True"
                        MaxLength="8192"
                        Style="{StaticResource AetherCustomOptionsTextBoxStyle}" />
                    <StackPanel x:Name="CustomOptionsErrors" Spacing="2" />
                    <TextBlock x:Name="CustomOptionsRestartNote" Foreground="{ThemeResource AetherTextSecondaryBrush}" Style="{StaticResource AetherCaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </settings:SettingsRow.Note>
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="MotionStyleRow" Glyph="&#xE916;">
            <ComboBox x:Name="MotionStyleCombo" Style="{StaticResource AetherSettingsComboStyle}" />
        </settings:SettingsRow>
        <settings:SettingsRow x:Name="ResetAllRow" Glyph="&#xE777;">
            <Button x:Name="ResetAllButton" Style="{StaticResource AetherOutlinePillButtonStyle}" />
        </settings:SettingsRow>
    </settings:SettingsGroup>
</Page>
