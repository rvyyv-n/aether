<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Aether_App.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Aether_App.Settings">

    <UserControl.Resources>
        <!--
            Section list item (6.1): 36 tall, radius 4, 16 px icon. Selected = FillEmphasisRest; no accent colour anywhere.
        -->
        <Style x:Key="SectionItemStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="{StaticResource AetherSizeNavItem}" />
            <Setter Property="MinHeight" Value="{StaticResource AetherSizeNavItem}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <!-- The row's fills and the focus ring both follow this radius; a Grid root let a square fill show in the corner. -->
            <Setter Property="CornerRadius" Value="{StaticResource AetherControlCornerRadius}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.083" />
                            </Border.BackgroundTransition>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource AetherFillSubtleHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource AetherFillSubtlePressedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource AetherFillEmphasisRestBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource AetherFillEmphasisHoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource AetherFillEmphasisPressedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SectionTemplate" x:DataType="local:SettingsSection">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Glyph="{x:Bind Glyph}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource AetherBodyTextStyle}"
                    Text="{x:Bind Title}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!--
        Settings (6.1): the section list sits straight on the Mica Alt backdrop and the section's page sits on a
        lighter layer with a rounded top-left corner and a 1 px edge, as in Wintoys. Below 640 px wide the list
        becomes a picker above the layer, which then runs edge to edge, so the page holds down to 405 px.
    -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact" />
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource AetherSizeSettingsCompactBreakpoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SectionList.Visibility" Value="Visible" />
                        <Setter Target="SectionPicker.Visibility" Value="Collapsed" />
                        <Setter Target="NavColumn.Width" Value="{StaticResource AetherSizeSettingsNav}" />
                        <Setter Target="ContentPane.BorderThickness" Value="1,1,0,0" />
                        <Setter Target="ContentPane.CornerRadius" Value="8,0,0,0" />
                        <Setter Target="ContentPanel.Padding" Value="32,24,32,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ListView
            x:Name="SectionList"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            Padding="8,8,8,8"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource SectionItemStyle}"
            ItemTemplate="{StaticResource SectionTemplate}"
            SelectionChanged="OnSectionChanged"
            SelectionMode="Single"
            Visibility="Collapsed" />

        <ComboBox
            x:Name="SectionPicker"
            Grid.Column="1"
            Margin="16,8,16,8"
            HorizontalAlignment="Stretch"
            ItemTemplate="{StaticResource SectionTemplate}"
            SelectionChanged="OnSectionChanged"
            Style="{StaticResource AetherSettingsComboStyle}" />

        <Grid
            x:Name="ContentPane"
            Grid.Row="1"
            Grid.Column="1"
            Background="{ThemeResource AetherSurfaceLayerBrush}"
            BorderBrush="{ThemeResource AetherStrokeLayerBrush}"
            BorderThickness="0,1,0,0">
            <ScrollViewer
                x:Name="ContentScroller"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!--  One capped column: the cards fill the pane up to the cap and stay left-aligned beyond it.  -->
                        <ColumnDefinition Width="*" MaxWidth="{StaticResource AetherSizeSettingsContentMax}" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="ContentPanel"
                        Padding="16,16,16,16"
                        Spacing="16">
                        <TextBlock
                            x:Name="PageTitle"
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource AetherSubtitleTextStyle}" />
                        <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
