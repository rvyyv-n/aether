<?xml version="1.0" encoding="utf-8" ?>
<!--
    Settings controls (6.2): rows, expanders and the accent-free inputs that sit in them. Merge into App.xaml
    after DesignTokens.xaml. Selected and on states use white and the emphasis fills; there is no accent colour.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Aether_App.Settings">

    <Style x:Key="AetherSettingsHeaderButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="Center"
                        Background="{TemplateBinding Background}"
                        Content="{TemplateBinding Content}"
                        CornerRadius="{StaticResource AetherOverlayCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{StaticResource AetherFillSubtleHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{StaticResource AetherFillSubtlePressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked" />
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{StaticResource AetherFillSubtleHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{StaticResource AetherFillSubtlePressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled" />
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Row: 16 px icon in a 20 px slot, title Body, description Caption secondary, control on the right; min 60,
        padding 16,12. Rows with tall notes set VerticalContentAlignment Top to keep the icon and control by the title.
        A toggle's On/Off word (StateText) sits just left of the control. Note holds extra lines
        under the description, such as "Applies on restart · Restart engine". The card comes from SettingsGroup.
    -->
    <Style TargetType="settings:SettingsRow">
        <Setter Property="MinHeight" Value="{StaticResource AetherSizeSettingsRow}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="settings:SettingsRow">
                    <Grid
                        MinHeight="{TemplateBinding MinHeight}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ColumnSpacing="16"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="LayoutStates">
                                <VisualState x:Name="Wide" />
                                <VisualState x:Name="Narrow">
                                    <VisualState.Setters>
                                        <Setter Target="ControlArea.(Grid.Row)" Value="1" />
                                        <Setter Target="ControlArea.(Grid.Column)" Value="1" />
                                        <Setter Target="ControlArea.(Grid.ColumnSpan)" Value="2" />
                                        <Setter Target="ControlArea.HorizontalAlignment" Value="Left" />
                                        <Setter Target="ControlArea.Margin" Value="0,8,0,0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon
                            x:Name="Icon"
                            Width="20"
                            Height="20"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="{TemplateBinding Glyph}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource AetherBodyTextStyle}"
                                Text="{TemplateBinding Header}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DescriptionText"
                                Margin="0,2,0,0"
                                Foreground="{StaticResource AetherTextSecondaryBrush}"
                                Style="{StaticResource AetherCaptionTextStyle}"
                                Text="{TemplateBinding Description}"
                                TextWrapping="Wrap" />
                            <ContentPresenter x:Name="NotePresenter" Content="{TemplateBinding Note}" />
                        </StackPanel>
                        <StackPanel
                            x:Name="ControlArea"
                            Grid.Column="2"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Orientation="Horizontal"
                            Spacing="12">
                            <TextBlock
                                x:Name="StateTextBlock"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Foreground="{StaticResource AetherTextSecondaryBrush}"
                                Style="{StaticResource AetherBodyTextStyle}"
                                Text="{TemplateBinding StateText}" />
                            <ContentPresenter
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Expander: the header is the whole row and toggles the sub-rows. Its hover fill shares the card's 8 px corners.
    -->
    <Style TargetType="settings:SettingsExpander">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="settings:SettingsExpander">
                    <StackPanel
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid MinHeight="{StaticResource AetherSizeSettingsRow}">
                            <ToggleButton
                                x:Name="HeaderButton"
                                Padding="16,8,48,8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Style="{StaticResource AetherSettingsHeaderButtonStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        x:Name="Icon"
                                        Width="20"
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="{TemplateBinding Glyph}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource AetherBodyTextStyle}"
                                            Text="{TemplateBinding Header}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="DescriptionText"
                                            Foreground="{StaticResource AetherTextSecondaryBrush}"
                                            Style="{StaticResource AetherCaptionTextStyle}"
                                            Text="{TemplateBinding Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>
                            <!--  Outside the button so a toggle here takes its own clicks; the chevron is decoration  -->
                            <StackPanel
                                Margin="0,0,20,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="16">
                                <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding HeaderContent}" />
                                <FontIcon
                                    x:Name="Chevron"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    FontSize="12"
                                    Foreground="{StaticResource AetherTextSecondaryBrush}"
                                    IsHitTestVisible="False" />
                            </StackPanel>
                        </Grid>
                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Toggle 40×20: white track and ink knob when on (theme brushes in DesignTokens). The On/Off word is the row's StateText  -->
    <Style
        x:Key="AetherSettingsToggleStyle"
        BasedOn="{StaticResource DefaultToggleSwitchStyle}"
        TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style x:Key="AetherSegmentedItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{StaticResource AetherSizeSegmentedItem}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource AetherUiFont}" />
        <Setter Property="FontSize" Value="{StaticResource AetherBodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource AetherTextSecondaryBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid
                        x:Name="Root"
                        Background="Transparent"
                        CornerRadius="{StaticResource AetherControlCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AetherFillSubtleHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{StaticResource AetherTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AetherFillSubtlePressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AetherFillEmphasisRestBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{StaticResource AetherTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AetherFillEmphasisRestBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{StaticResource AetherTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AetherFillEmphasisHoverBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{StaticResource AetherTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="SelectedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource AetherFillEmphasisPressedBrush}" />
                                        <Setter Target="Presenter.Foreground" Value="{StaticResource AetherTextPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="Presenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Segmented: 32 container (FillInput, StrokeControl, radius 4, padding 2), 28 items, selected FillEmphasis  -->
    <Style x:Key="AetherSegmentedStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource AetherFillInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AetherStrokeControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AetherControlCornerRadius}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource AetherSegmentedItemStyle}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Combo box: 32 tall, FillInput, StrokeControl, radius 4  -->
    <Style
        x:Key="AetherSettingsComboStyle"
        BasedOn="{StaticResource DefaultComboBoxStyle}"
        TargetType="ComboBox">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="{StaticResource AetherSizeComboHeight}" />
        <Setter Property="Background" Value="{StaticResource AetherFillInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AetherStrokeControlBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource AetherControlCornerRadius}" />
    </Style>

    <Style
        x:Key="AetherSettingsSliderStyle"
        BasedOn="{StaticResource DefaultSliderStyle}"
        TargetType="Slider">
        <Setter Property="Width" Value="200" />
    </Style>

    <!--  Quiet text button beside a control, such as Reset on a sub-row that differs from its default  -->
    <Style
        x:Key="AetherSettingsTextButtonStyle"
        BasedOn="{StaticResource AetherOutlinePillButtonStyle}"
        TargetType="Button">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AetherTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource AetherCaptionFontSize}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!--  Keycaps that start recording a new shortcut when clicked: no frame of their own, hover fill only  -->
    <Style
        x:Key="AetherKeycapButtonStyle"
        BasedOn="{StaticResource AetherOutlinePillButtonStyle}"
        TargetType="Button">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource AetherControlCornerRadius}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <!--  Keycap: 24 tall, min 24 wide, padding 8,0, FillInput, StrokeControl, radius 4, Caption  -->
    <Style x:Key="AetherKeycapStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource AetherSizeKeycap}" />
        <Setter Property="MinWidth" Value="{StaticResource AetherSizeKeycap}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="{StaticResource AetherFillInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AetherStrokeControlBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AetherControlCornerRadius}" />
    </Style>
</ResourceDictionary>
